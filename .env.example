# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml for the scoreboard client.

# Share data with the panel (pull clubs/teams/players, push match results). Off unless set to true;
# the client works on its own without it.
SCOREBOARD_SYNC_ENABLED=false

# The venue's client id: panel -> Bağlantı (Connection) page.
SCOREBOARD_CLIENT_ID=

# This table's scoreboard number: listed on the same page ("X-Table-No").
SCOREBOARD_TABLE_NO=1

# How often the client pulls clubs/teams/players and pushes match results (seconds, minimum 5).
SCOREBOARD_POLL_SECONDS=15
