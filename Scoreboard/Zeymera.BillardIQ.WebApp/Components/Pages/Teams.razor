@page "/teams"
@attribute [Authorize]
@inject TeamService TeamService
@inject PlayerService Players
@inject AuthenticationStateProvider AuthState

<h1>Teams</h1>

<EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="team-form">
    <DataAnnotationsValidator />
    <div class="form-row">
        <InputText @bind-Value="_form.Name" placeholder="Team name" />
        <button type="submit">@(_form.Id == 0 ? "Add Team" : "Save Team")</button>
        @if (_form.Id != 0)
        {
            <button type="button" @onclick="ResetForm">Cancel</button>
        }
    </div>
    <ValidationSummary />
</EditForm>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@if (_teams is null || _players is null)
{
    <p>Loading...</p>
}
else if (_teams.Count == 0)
{
    <p>No teams yet.</p>
}
else
{
    @foreach (var team in _teams)
    {
        <div class="team-card">
            <div class="team-header">
                <strong>@team.Name</strong>
                <div class="row-actions">
                    <button @onclick="() => Edit(team)">Edit</button>
                    <button @onclick="() => DeleteAsync(team.Id)">Delete</button>
                </div>
            </div>
            @if (_players.Count == 0)
            {
                <p class="hint">Add players to this club first.</p>
            }
            else
            {
                <div class="team-players">
                    @foreach (var player in _players)
                    {
                        var isMember = team.TeamPlayers.Any(tp => tp.PlayerId == player.Id);
                        <label class="player-toggle">
                            <input type="checkbox" checked="@isMember"
                                   @onchange="e => ToggleMembershipAsync(team, player.Id, (bool)e.Value!)" />
                            @player.Nickname
                        </label>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private int _clubId;
    private List<Team>? _teams;
    private List<Player>? _players;
    private string? _error;
    private TeamFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _clubId = int.Parse(state.User.FindFirst("ClubId")!.Value);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _teams = await TeamService.ListForClubAsync(_clubId);
        _players = await Players.ListForClubAsync(_clubId);
    }

    private void Edit(Team team) => _form = new TeamFormModel { Id = team.Id, Name = team.Name };

    private void ResetForm() => _form = new TeamFormModel();

    private async Task SaveAsync()
    {
        _error = null;
        try
        {
            await TeamService.UpsertAsync(_clubId, _form.Id, _form.Name);
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(int id)
    {
        await TeamService.DeleteAsync(_clubId, id);
        await LoadAsync();
    }

    private async Task ToggleMembershipAsync(Team team, int playerId, bool isMember)
    {
        var currentIds = team.TeamPlayers.Select(tp => tp.PlayerId).ToHashSet();
        if (isMember)
        {
            currentIds.Add(playerId);
        }
        else
        {
            currentIds.Remove(playerId);
        }

        try
        {
            await TeamService.SetPlayersAsync(_clubId, team.Id, currentIds.ToArray());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private class TeamFormModel
    {
        public int Id { get; set; }

        [Required]
        public string Name { get; set; } = string.Empty;
    }
}
