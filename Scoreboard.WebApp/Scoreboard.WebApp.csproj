<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net11.0</TargetFramework>
	<Features>runtime-async=on</Features>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a6bb0fbf-943c-416f-9ed8-b2f4f7ecfd7d</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Scoreboard.WebApp.Domain" />
    <Using Include="Scoreboard.Common" />
  </ItemGroup>

  <!-- Legacy int-keyed models + old migration, superseded by Domain/ (kept on disk, excluded from the build) -->
  <ItemGroup>
    <Compile Remove="Models\Club.cs;Models\Player.cs;Models\Team.cs;Models\TeamPlayer.cs;Models\ScoreboardClient.cs;Models\MatchResult.cs;Models\ScoreEvent.cs;Migrations\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Avatars/animals.json" LogicalName="Avatars.animals.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
	  </PackageReference>
	  <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
