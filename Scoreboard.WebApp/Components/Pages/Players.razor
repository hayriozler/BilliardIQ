@page "/players"
@attribute [Authorize]
@inject ScopedRunner Db
@inject TenantContext TenantContext

<PageTitle>Oyuncular • BillardIQ</PageTitle>

<div class="page-head">
    <div>
        <h1>Oyuncular</h1>
        <div class="subtitle">Salonunuzun oyuncu kayıtları. Scoreboard cihazları bu listeyi kullanır.</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert error">@_error</div>
}

<div class="card">
    <h2>@(_form.Id == 0 ? "Yeni oyuncu" : "Oyuncuyu düzenle")</h2>
    <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="player-form">
        <DataAnnotationsValidator />
        <div class="form-grid">
            <label class="field">Takma ad<InputText @bind-Value="_form.Nickname" /></label>
            <label class="field">Ad soyad<InputText @bind-Value="_form.Name" /></label>
            <label class="field">E-posta<InputText @bind-Value="_form.Email" /></label>
            <label class="field">
                Seviye
                <InputSelect @bind-Value="_form.Level">
                    @foreach (var level in Enum.GetValues<Level>())
                    {
                        <option value="@level">@LevelName(level)</option>
                    }
                </InputSelect>
            </label>
            <label class="field">Ülke<InputText @bind-Value="_form.BaseCountry" /></label>
            <label class="field">Şehir<InputText @bind-Value="_form.BaseCity" /></label>
            <label class="field">Fotoğraf<InputFile OnChange="OnPhotoSelectedAsync" accept="image/*" /></label>
        </div>
        <ValidationSummary />
        <div class="form-actions">
            <button type="submit" class="primary" disabled="@_busy">@(_form.Id == 0 ? "Oyuncu ekle" : "Kaydet")</button>
            @if (_form.Id != 0)
            {
                <button type="button" @onclick="ResetForm">Vazgeç</button>
            }
        </div>
    </EditForm>
</div>

<div class="card">
    <h2>Oyuncular (@(_players?.Count ?? 0))</h2>
    @if (_players is null)
    {
        <p class="muted">Yükleniyor...</p>
    }
    else if (_players.Count == 0)
    {
        <div class="empty">Henüz oyuncu yok.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th></th><th>Takma ad</th><th>Ad soyad</th><th>Seviye</th><th>E-posta</th><th>Konum</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var player in _players)
                    {
                        <tr>
                            <td>
                                @if (player.PhotoUrl is not null)
                                {
                                    <img src="@($"/{player.PhotoUrl}")" class="thumb" alt="" />
                                }
                                else
                                {
                                    <div class="avatar">@Initial(player)</div>
                                }
                            </td>
                            <td><strong>@player.Nickname</strong></td>
                            <td>@($"{player.FirstName} {player.LastName}".Trim())</td>
                            <td>@LevelName(player.Level)</td>
                            <td>@player.Email</td>
                            <td>@string.Join(", ", new[] { player.City, player.Nationality }.Where(s => !string.IsNullOrWhiteSpace(s)))</td>
                            <td>
                                <div class="row-actions">
                                    <button class="small" @onclick="() => Edit(player)">Düzenle</button>
                                    @if (_confirmDelete == player.Id)
                                    {
                                        <button class="small danger" disabled="@_busy" @onclick="() => DeleteAsync(player.Id)">Silmeyi onayla</button>
                                        <button class="small ghost" @onclick="() => _confirmDelete = null">Vazgeç</button>
                                    }
                                    else
                                    {
                                        <button class="small ghost" @onclick="() => _confirmDelete = player.Id">Sil</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private Tenant? _tenant;
    private List<Player>? _players;
    private string? _error;
    private bool _busy;
    private int? _confirmDelete;
    private PlayerFormModel _form = new();
    private string? _pendingPhotoBase64;
    private string? _pendingPhotoExtension;

    protected override async Task OnInitializedAsync()
    {
        _tenant = await TenantContext.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var orgId = _tenant!.OrganizationId;
        _players = await Db.RunAsync((PlayerService s) => s.ListForOrganizationAsync(orgId));
    }

    private static string LevelName(Level level) => level switch
    {
        Level.Beginner => "Başlangıç",
        Level.Intermidiate => "Orta",
        Level.Advanced => "İleri",
        Level.Professional => "Profesyonel",
        _ => level.ToString()
    };

    private static string Initial(Player player)
    {
        var text = player.Nickname ?? player.FirstName;
        return string.IsNullOrEmpty(text) ? "?" : text[..1].ToUpperInvariant();
    }

    private void Edit(Player player)
    {
        _form = new PlayerFormModel
        {
            Id = player.Id,
            Nickname = player.Nickname ?? string.Empty,
            Name = $"{player.FirstName} {player.LastName}".Trim(),
            Email = player.Email ?? string.Empty,
            Level = player.Level,
            BaseCountry = player.Nationality ?? string.Empty,
            BaseCity = player.City ?? string.Empty
        };
        _pendingPhotoBase64 = null;
        _pendingPhotoExtension = null;
    }

    private void ResetForm()
    {
        _form = new PlayerFormModel();
        _pendingPhotoBase64 = null;
        _pendingPhotoExtension = null;
    }

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        const long maxSize = 5 * 1024 * 1024;
        await using var stream = e.File.OpenReadStream(maxSize);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        _pendingPhotoBase64 = Convert.ToBase64String(memory.ToArray());
        _pendingPhotoExtension = Path.GetExtension(e.File.Name).TrimStart('.');
    }

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            await Db.RunAsync((PlayerService s) => s.UpsertAsync(
                _tenant!.OrganizationId, _form.Id, _form.Nickname, _form.Name, null,
                _form.Email, _form.Level, _form.BaseCountry, _form.BaseCity,
                _pendingPhotoBase64, _pendingPhotoExtension));
            ResetForm();
        }
        catch (Exception ex) when (ex is ArgumentException or IOException)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        _busy = true;
        try
        {
            await Db.RunAsync((PlayerService s) => s.DeleteAsync(_tenant!.OrganizationId, id));
            _confirmDelete = null;
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private class PlayerFormModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Takma ad gerekli.")]
        public string Nickname { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ad soyad gerekli.")]
        public string Name { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public Level Level { get; set; } = Level.Intermidiate;

        public string BaseCountry { get; set; } = string.Empty;

        public string BaseCity { get; set; } = string.Empty;
    }
}
