@page "/teams"
@attribute [Authorize]
@inject ScopedRunner Db
@inject TenantContext TenantContext

<PageTitle>@L["Takımlar"] • BilliardIQ</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["Takımlar"]</h1>
        <div class="subtitle">@L["Takımlar bir kulübe bağlıdır. Oyuncuları işaretleyerek kadroyu belirleyin."]</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert error">@_error</div>
}

<div class="card">
    <h2>@(_form.Id == 0 ? L["Yeni takım"] : L["Takımı düzenle"])</h2>
    @if (_clubs is { Count: 0 })
    {
        <p class="hint">@L["Kulüp seçilmezse ilk kulüp kullanılır."] <a href="/clubs">@L["Kulüp ekleyin"]</a>.</p>
    }
    <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="team-form">
        <DataAnnotationsValidator />
        <div class="form-row">
            <label class="field">@L["Takım adı"]<InputText @bind-Value="_form.Name" placeholder="Kadıköy BSK A" /></label>
            <label class="field">@L["Kulüp"]
                <InputSelect @bind-Value="_form.ClubId">
                    <option value="">@(_clubs is { Count: 0 } ? L["Otomatik oluştur"] : L["İlk kulüp"])</option>
                    @foreach (var club in _clubs ?? [])
                    {
                        <option value="@club.Id">@club.Name</option>
                    }
                </InputSelect>
            </label>
            <div class="field">@L["Avatar"]<AvatarPicker @bind-Value="_form.AvatarId" /></div>
            <button type="submit" class="primary" disabled="@_busy">@(_form.Id == 0 ? L["Takım ekle"] : L["Kaydet"])</button>
            @if (_form.Id != 0)
            {
                <button type="button" @onclick="ResetForm">@L["Vazgeç"]</button>
            }
        </div>
        <LocalizedValidationSummary />
    </EditForm>
</div>

@if (_teams is null || _players is null)
{
    <p class="muted">@L["Yükleniyor..."]</p>
}
else if (_teams.Count == 0)
{
    <div class="card empty">@L["Henüz takım yok."]</div>
}
else
{
    @foreach (var team in _teams)
    {
        <div class="team-card">
            <div class="team-header">
                <div class="team-title">
                    @if (team.AvatarId is int teamAvatar)
                    {
                        <img src="@AvatarGenerator.ToDataUri(teamAvatar, 40)" class="thumb" alt="" />
                    }
                    <div>
                    <strong>@team.Name</strong>
                    <div class="muted">@team.Club.Name • @L["{0} oyuncu", team.Members.Count]</div>
                    </div>
                </div>
                <div class="row-actions">
                    <button class="small" @onclick="() => Edit(team)">@L["Düzenle"]</button>
                    @if (_confirmDelete == team.Id)
                    {
                        <button class="small danger" disabled="@_busy" @onclick="() => DeleteAsync(team.Id)">@L["Silmeyi onayla"]</button>
                        <button class="small ghost" @onclick="() => _confirmDelete = null">@L["Vazgeç"]</button>
                    }
                    else
                    {
                        <button class="small ghost" @onclick="() => _confirmDelete = team.Id">@L["Sil"]</button>
                    }
                </div>
            </div>
            @if (_players.Count == 0)
            {
                <p class="hint">@L["Önce"] <a href="/players">@L["oyuncu ekleyin"]</a>.</p>
            }
            else
            {
                <div class="team-players">
                    @foreach (var player in _players)
                    {
                        var isMember = team.Members.Any(m => m.PlayerId == player.Id);
                        <label class="player-toggle">
                            <input type="checkbox" checked="@isMember"
                                   @onchange="e => ToggleMembershipAsync(team, player.Id, (bool)e.Value!)" />
                            @player.DisplayName
                        </label>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private Tenant? _tenant;
    private List<Team>? _teams;
    private List<Player>? _players;
    private List<Club>? _clubs;
    private string? _error;
    private bool _busy;
    private int? _confirmDelete;
    private TeamFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _tenant = await TenantContext.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _teams = await Db.RunAsync((TeamService s) => s.ListForOrganizationAsync());
        _players = (await Db.RunAsync((PlayerService s) => s.ListForOrganizationAsync())).Where(p => !p.IsSystem).ToList();
        _clubs = await Db.RunAsync((ClubService s) => s.ListAsync());
    }

    private void Edit(Team team) =>
        _form = new TeamFormModel { Id = team.Id, Name = team.Name, ClubId = team.ClubId.ToString(), AvatarId = team.AvatarId };

    private void ResetForm() => _form = new TeamFormModel();

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            int? clubId = int.TryParse(_form.ClubId, out var parsed) ? parsed : null;
            await Db.RunAsync((TeamService s) => s.UpsertAsync(_form.Id, _form.Name, clubId, _form.AvatarId));
            ResetForm();
        }
        catch (ArgumentException ex)
        {
            _error = L.Error(ex);
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        _busy = true;
        try
        {
            await Db.RunAsync((TeamService s) => s.DeleteAsync(id));
            _confirmDelete = null;
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private async Task ToggleMembershipAsync(Team team, int playerId, bool isMember)
    {
        var currentIds = team.Members.Select(m => m.PlayerId).ToHashSet();
        if (isMember)
        {
            currentIds.Add(playerId);
        }
        else
        {
            currentIds.Remove(playerId);
        }

        _error = null;
        try
        {
            await Db.RunAsync((TeamService s) => s.SetPlayersAsync(team.Id, currentIds.ToArray()));
        }
        catch (ArgumentException ex)
        {
            _error = L.Error(ex);
        }

        await LoadAsync();
    }

    private class TeamFormModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Takım adı gerekli.")]
        public string Name { get; set; } = string.Empty;

        public string ClubId { get; set; } = string.Empty;

        public int? AvatarId { get; set; }
    }
}
