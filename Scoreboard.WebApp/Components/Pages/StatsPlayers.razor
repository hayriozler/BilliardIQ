@page "/stats/players"
@attribute [Authorize]
@inject ScopedRunner Db
@inject TenantContext TenantContext

<PageTitle>@L["Oyuncu istatistikleri"] • BilliardIQ</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["Oyuncu istatistikleri"]</h1>
        <div class="subtitle">@L["Scoreboard'lardan gelen maç sonuçlarına göre oyuncu başarı özeti."]</div>
    </div>
    <div class="row-actions">
        <a class="small-link" href="/stats/teams">@L["Takım istatistikleri"]</a>
    </div>
</div>

<div class="card">
    <div class="form-row">
        <label class="field">@L["Oyuncu ara"]
            <input type="text" @bind="_search" @bind:event="oninput" />
        </label>
        <StatsRangeSelect Value="@_range" ValueChanged="OnRangeChangedAsync" />
    </div>
</div>

<div class="card">
    <h2>@L["Oyuncular"] (@Visible.Count)</h2>
    @if (_rows is null)
    {
        <p class="muted">@L["Yükleniyor..."]</p>
    }
    else if (Visible.Count == 0)
    {
        <div class="empty">@L["Henüz maç sonucu yok."]</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th><th></th><th>@L["Takma ad"]</th>
                        <th class="num">@L["Maçlar"]</th><th class="num">@L["Galibiyet"]</th><th class="num">@L["Mağlubiyet"]</th>
                        <th class="num">@L["Kazanma %"]</th><th class="num">@L["Ort. El"]</th><th class="num">@L["Ort. / El"]</th>
                        <th class="num">@L["En iyi ort."]</th><th class="num">@L["En yüksek seri"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Visible.Count; i++)
                    {
                        var row = Visible[i];
                        var s = row.Summary;
                        <tr>
                            <td>@(i + 1)</td>
                            <td><PlayerAvatar Player="row.Player" Size="36" /></td>
                            <td><a href="/stats/players/@row.Player.Id"><strong>@(row.Player.Nickname ?? row.Player.DisplayName)</strong></a>
                                <div class="muted">@($"{row.Player.FirstName} {row.Player.LastName}".Trim())</div></td>
                            <td class="num">@s.Matches</td>
                            <td class="num win">@s.Wins</td>
                            <td class="num loss">@s.Losses</td>
                            <td class="num">@(s.Matches == 0 ? "—" : s.WinPercent.ToString("0") + " %")</td>
                            <td class="num">@(s.Matches == 0 ? "—" : s.AverageInnings.ToString("0.0"))</td>
                            <td class="num">@(s.Matches == 0 ? "—" : s.AveragePerInning.ToString("0.000"))</td>
                            <td class="num">@(s.Matches == 0 ? "—" : s.BestAverage.ToString("0.000"))</td>
                            <td class="num">@(s.Matches == 0 ? "—" : s.BestHighRun.ToString())</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private Tenant? _tenant;
    private List<PlayerStatRow>? _rows;
    private string _search = "";
    private StatsPeriod _range = StatsPeriod.Default;

    private List<PlayerStatRow> Visible => (_rows ?? [])
        .Where(r => string.IsNullOrWhiteSpace(_search) ||
                    ($"{r.Player.Nickname} {r.Player.FirstName} {r.Player.LastName}").Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _tenant = await TenantContext.GetAsync();
        await LoadAsync();
    }

    private async Task OnRangeChangedAsync(StatsPeriod range)
    {
        _range = range;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var since = _range.Since;
        var until = _range.Until;
        _rows = await Db.RunAsync((StatsService s) => s.PlayersAsync(since, until));
    }
}
