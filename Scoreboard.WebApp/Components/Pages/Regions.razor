@page "/regions"
@attribute [Authorize]
@inject ScopedRunner Db
@inject TenantContext TenantContext

<PageTitle>@L["Bölgeler"] • BillardIQ</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["Bölgeler"]</h1>
        <div class="subtitle">@L["Organizasyonunuzun kullandığı bölgeleri katalogdan seçin; oyuncu formunda listeden seçilir."]</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert error">@_error</div>
}

@if (_tenant is { CanManage: true })
{
    <div class="card">
        <h2>@L["Katalogdan bölge ekle"]</h2>
        <div class="form-row">
            <label class="field">@L["Bölge"]
                <select @bind="_selectedId">
                    <option value="0">@L["Bölge seçin"]</option>
                    @foreach (var region in _available)
                    {
                        <option value="@region.Id">@region.Country.Name · @region.Name</option>
                    }
                </select>
            </label>
            <button class="primary" disabled="@(_busy || _selectedId == 0)" @onclick="AddAsync">@L["Ekle"]</button>
        </div>
    </div>
}

<div class="card">
    <h2>@L["Bölgeler"] (@_regions.Count)</h2>
    @if (_regions.Count == 0)
    {
        <div class="empty">@L["Henüz bölge yok."]</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>@L["Ad"]</th><th class="num">@L["Oyuncu sayısı"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var region in _regions)
                    {
                        <tr>
                            <td><strong>@region.Name</strong></td>
                            <td class="num">@_playerCounts.GetValueOrDefault(region.Id)</td>
                            <td>
                                @if (_tenant is { CanManage: true })
                                {
                                    <div class="row-actions">
                                        @if (_confirmDelete == region.Id)
                                        {
                                            <button class="small danger" disabled="@_busy" @onclick="() => DeleteAsync(region.Id)">@L["Silmeyi onayla"]</button>
                                            <button class="small ghost" @onclick="() => _confirmDelete = null">@L["Vazgeç"]</button>
                                        }
                                        else
                                        {
                                            <button class="small ghost" @onclick="() => _confirmDelete = region.Id">@L["Sil"]</button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private Tenant? _tenant;
    private List<Region> _regions = [];
    private List<Region> _available = [];
    private Dictionary<int, int> _playerCounts = [];
    private int _selectedId;
    private string? _error;
    private bool _busy;
    private int? _confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        _tenant = await TenantContext.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var orgId = _tenant!.OrganizationId;
        _regions = await Db.RunAsync((RegionService s) => s.ListAsync(orgId));
        _available = await Db.RunAsync((RegionService s) => s.AvailableAsync(orgId));
        var players = await Db.RunAsync((PlayerService s) => s.ListForOrganizationAsync(orgId));
        _playerCounts = players.Where(p => p.RegionId != null)
            .GroupBy(p => p.RegionId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private Task AddAsync() => RunAsync(async () =>
    {
        await Db.RunAsync((RegionService s) => s.AddAsync(_tenant!.OrganizationId, _selectedId));
        _selectedId = 0;
    });

    private Task DeleteAsync(int id) => RunAsync(async () =>
    {
        await Db.RunAsync((RegionService s) => s.DeleteAsync(_tenant!.OrganizationId, id));
        _confirmDelete = null;
    });

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _error = L.Error(ex);
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }
}
