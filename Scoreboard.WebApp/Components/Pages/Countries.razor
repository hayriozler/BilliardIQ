@page "/countries"
@attribute [Authorize]
@inject ScopedRunner Db
@inject TenantContext TenantContext

<PageTitle>@L["Ülkeler"] • BillardIQ</PageTitle>

<div class="page-head">
    <div>
        <h1>@L["Ülkeler"]</h1>
        <div class="subtitle">@L["Oyuncuların ülkelerini bir kez tanımlayın; oyuncu formunda ve şehir tanımında listeden seçilir."]</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert error">@_error</div>
}

@if (_tenant is { CanManage: true })
{
    <div class="card">
        <h2>@(_form.Id == 0 ? L["Yeni ülke"] : L["Ülkeyi düzenle"])</h2>
        <div class="form-row">
            <label class="field">@L["Ad"]
                <input type="text" @bind="_form.Name" maxlength="150" />
            </label>
            <button class="primary" disabled="@_busy" @onclick="SaveAsync">@(_form.Id == 0 ? L["Ekle"] : L["Kaydet"])</button>
            @if (_form.Id != 0)
            {
                <button @onclick="() => _form = new()">@L["Vazgeç"]</button>
            }
        </div>
    </div>
}

<div class="card">
    <h2>@L["Ülkeler"] (@_countrys.Count)</h2>
    @if (_countrys.Count == 0)
    {
        <div class="empty">@L["Henüz ülke yok."]</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>@L["Ad"]</th><th class="num">@L["Oyuncu sayısı"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var country in _countrys)
                    {
                        <tr>
                            <td><strong>@country.Name</strong></td>
                            <td class="num">@_playerCounts.GetValueOrDefault(country.Id)</td>
                            <td>
                                @if (_tenant is { CanManage: true })
                                {
                                    <div class="row-actions">
                                        <button class="small" @onclick="() => _form = new FormModel { Id = country.Id, Name = country.Name }">@L["Düzenle"]</button>
                                        @if (_confirmDelete == country.Id)
                                        {
                                            <button class="small danger" disabled="@_busy" @onclick="() => DeleteAsync(country.Id)">@L["Silmeyi onayla"]</button>
                                            <button class="small ghost" @onclick="() => _confirmDelete = null">@L["Vazgeç"]</button>
                                        }
                                        else
                                        {
                                            <button class="small ghost" @onclick="() => _confirmDelete = country.Id">@L["Sil"]</button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private Tenant? _tenant;
    private List<Country> _countrys = [];
    private Dictionary<int, int> _playerCounts = [];
    private FormModel _form = new();
    private string? _error;
    private bool _busy;
    private int? _confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        _tenant = await TenantContext.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var orgId = _tenant!.OrganizationId;
        _countrys = await Db.RunAsync((CountryService s) => s.ListAsync(orgId));
        var players = await Db.RunAsync((PlayerService s) => s.ListForOrganizationAsync(orgId));
        _playerCounts = players.Where(p => p.CountryId != null)
            .GroupBy(p => p.CountryId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        await Db.RunAsync((CountryService s) => s.UpsertAsync(_tenant!.OrganizationId, _form.Id, _form.Name));
        _form = new FormModel();
    });

    private Task DeleteAsync(int id) => RunAsync(async () =>
    {
        await Db.RunAsync((CountryService s) => s.DeleteAsync(_tenant!.OrganizationId, id));
        _confirmDelete = null;
    });

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _error = L.Error(ex);
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private class FormModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
}
