@using Scoreboard.WebApp.Security

<aside class="sidebar">
    <div class="brand">
        <span class="brand-mark">🎱</span>
        <span>BillardIQ</span>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="org">
                <span>@L["Salon"]</span>
                <strong>@context.User.FindFirst(AuthClaims.OrganizationName)?.Value</strong>
            </div>

            <nav>
                <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-ico">📊</span>@L["Masalar"]</NavLink>
                <NavLink href="/tables"><span class="nav-ico">🟩</span>@L["Masa yönetimi"]</NavLink>
                <NavLink href="/pricing"><span class="nav-ico">💰</span>@L["Fiyatlandırma"]</NavLink>
                <NavLink href="/products"><span class="nav-ico">🍹</span>@L["Ürünler"]</NavLink>

                <div class="nav-section">@L["Oyuncular"]</div>
                <NavLink href="/players"><span class="nav-ico">🧑</span>@L["Oyuncular"]</NavLink>
                <NavLink href="/associations"><span class="nav-ico">🏅</span>@L["Dernekler"]</NavLink>
                <NavLink href="/clubs"><span class="nav-ico">🏛️</span>@L["Kulüpler"]</NavLink>
                <NavLink href="/teams"><span class="nav-ico">👥</span>@L["Takımlar"]</NavLink>
                <NavLink href="/tournaments"><span class="nav-ico">🏆</span>@L["Turnuvalar"]</NavLink>

                <div class="nav-section">@L["İstatistikler"]</div>
                <NavLink href="/stats/players"><span class="nav-ico">📈</span>@L["Oyuncu istatistikleri"]</NavLink>
                <NavLink href="/stats/teams"><span class="nav-ico">🛡️</span>@L["Takım istatistikleri"]</NavLink>

                <div class="nav-section">@L["Sistem"]</div>
                <NavLink href="/devices"><span class="nav-ico">📟</span>@L["Bağlantı"]</NavLink>
                @if (context.User.IsInRole(nameof(StaffRole.Owner)) || context.User.IsInRole(nameof(StaffRole.Manager)))
                {
                    <NavLink href="/staff"><span class="nav-ico">🔑</span>@L["Kullanıcılar"]</NavLink>
                }
            </nav>

            <LanguageSwitcher />

            <div class="user-box">
                <strong>@context.User.Identity?.Name</strong>
                <span>@string.Join(", ", context.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => Enum.TryParse<StaffRole>(c.Value, out var r) ? Format.Role(r) : c.Value))</span>
                <form method="post" action="/logout">
                    <button type="submit">@L["Çıkış yap"]</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</aside>
