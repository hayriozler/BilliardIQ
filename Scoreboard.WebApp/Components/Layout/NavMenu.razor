@using Scoreboard.WebApp.Security
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<aside class="sidebar">
    <div class="brand">
        <img class="brand-logo" src="images/zeymera-ram.png" alt="Zeymera" />
        <span>BilliardIQ</span>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="org">
                <span>@L["Salon"]</span>
                <strong>@context.User.FindFirst(AuthClaims.OrganizationName)?.Value</strong>
            </div>

            <nav>
                <div class="nav-group @(IsOpen("ops") ? "" : "collapsed")">
                    <button type="button" class="nav-toggle" aria-expanded="@IsOpen("ops")" @onclick='() => ToggleAsync("ops")'><span>@L["İşletme"]</span><span class="chev">▾</span></button>
                    @if (IsOpen("ops"))
                    {
                        <div class="nav-items">
                            <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-ico">📊</span>@L["Masalar"]</NavLink>
                            <NavLink href="/tables"><span class="nav-ico">🟩</span>@L["Masa yönetimi"]</NavLink>
                            <NavLink href="/pricing"><span class="nav-ico">💰</span>@L["Fiyatlandırma"]</NavLink>
                            <NavLink href="/products"><span class="nav-ico">🍹</span>@L["Ürünler"]</NavLink>
                        </div>
                    }
                </div>

                <div class="nav-group @(IsOpen("people") ? "" : "collapsed")">
                    <button type="button" class="nav-toggle" aria-expanded="@IsOpen("people")" @onclick='() => ToggleAsync("people")'><span>@L["Oyuncular"]</span><span class="chev">▾</span></button>
                    @if (IsOpen("people"))
                    {
                        <div class="nav-items">
                            @if (context.User.CanManage())
                            {
                                <NavLink href="/players"><span class="nav-ico">🧑</span>@L["Oyuncular"]</NavLink>
                                <NavLink href="/clubs"><span class="nav-ico">🏛️</span>@L["Kulüpler"]</NavLink>
                                <NavLink href="/teams"><span class="nav-ico">👥</span>@L["Takımlar"]</NavLink>
                            }
                            <NavLink href="/tournaments"><span class="nav-ico">🏆</span>@L["Turnuvalar"]</NavLink>
                        </div>
                    }
                </div>

                <div class="nav-group @(IsOpen("defs") ? "" : "collapsed")">
                    <button type="button" class="nav-toggle" aria-expanded="@IsOpen("defs")" @onclick='() => ToggleAsync("defs")'><span>@L["Tanımlar"]</span><span class="chev">▾</span></button>
                    @if (IsOpen("defs"))
                    {
                        <div class="nav-items">
                            <NavLink href="/associations"><span class="nav-ico">🏅</span>@L["Dernekler"]</NavLink>
                            <NavLink href="/regions"><span class="nav-ico">🗺️</span>@L["Bölgeler"]</NavLink>
                            <NavLink href="/countries"><span class="nav-ico">🌍</span>@L["Ülkeler"]</NavLink>
                            <NavLink href="/cities"><span class="nav-ico">🏙️</span>@L["Şehirler"]</NavLink>
                        </div>
                    }
                </div>

                <div class="nav-group @(IsOpen("stats") ? "" : "collapsed")">
                    <button type="button" class="nav-toggle" aria-expanded="@IsOpen("stats")" @onclick='() => ToggleAsync("stats")'><span>@L["İstatistikler"]</span><span class="chev">▾</span></button>
                    @if (IsOpen("stats"))
                    {
                        <div class="nav-items">
                            <NavLink href="/stats/players"><span class="nav-ico">📈</span>@L["Oyuncu istatistikleri"]</NavLink>
                            <NavLink href="/stats/teams"><span class="nav-ico">🛡️</span>@L["Takım istatistikleri"]</NavLink>
                        </div>
                    }
                </div>

                <div class="nav-group @(IsOpen("system") ? "" : "collapsed")">
                    <button type="button" class="nav-toggle" aria-expanded="@IsOpen("system")" @onclick='() => ToggleAsync("system")'><span>@L["Sistem"]</span><span class="chev">▾</span></button>
                    @if (IsOpen("system"))
                    {
                        <div class="nav-items">
                            <NavLink href="/devices"><span class="nav-ico">📟</span>@L["Bağlantı"]</NavLink>
                            @if (context.User.IsInRole(nameof(StaffRole.Owner)) || context.User.IsInRole(nameof(StaffRole.Manager)))
                            {
                                <NavLink href="/staff"><span class="nav-ico">🔑</span>@L["Kullanıcılar"]</NavLink>
                            }
                        </div>
                    }
                </div>
            </nav>

            <LanguageSwitcher />

            <div class="user-box">
                <strong>@context.User.Identity?.Name</strong>
                <span>@string.Join(", ", context.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => Enum.TryParse<StaffRole>(c.Value, out var r) ? Format.Role(r) : c.Value))</span>
                <form method="post" action="/logout">
                    <button type="submit">@L["Çıkış yap"]</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</aside>

@code {
    private const string StorageKey = "billiardiq.nav.open";

    private static readonly Dictionary<string, string> GroupOf = new(StringComparer.OrdinalIgnoreCase)
    {
        [""] = "ops", ["tables"] = "ops", ["pricing"] = "ops", ["products"] = "ops",
        ["players"] = "people", ["associations"] = "defs", ["regions"] = "defs", ["countries"] = "defs", ["cities"] = "defs", ["clubs"] = "people", ["teams"] = "people", ["tournaments"] = "people",
        ["stats"] = "stats",
        ["devices"] = "system", ["staff"] = "system"
    };

    private readonly HashSet<string> _open = ["ops"];

    private bool IsOpen(string group) => _open.Contains(group);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        OpenActiveGroup();
    }

    private bool OpenActiveGroup()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var end = path.IndexOfAny(['/', '?', '#']);
        var segment = end < 0 ? path : path[..end];
        return GroupOf.TryGetValue(segment, out var group) && _open.Add(group);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (OpenActiveGroup())
        {
            _ = InvokeAsync(async () =>
            {
                StateHasChanged();
                await SaveAsync();
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrEmpty(saved))
            {
                _open.Clear();
                foreach (var key in saved.Split(',', StringSplitOptions.RemoveEmptyEntries).Where(k => GroupOf.ContainsValue(k)))
                {
                    _open.Add(key);
                }

                OpenActiveGroup();
                StateHasChanged();
            }
        }
        catch (Exception)
        {
        }
    }

    private async Task ToggleAsync(string group)
    {
        if (!_open.Remove(group))
        {
            _open.Add(group);
        }

        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, string.Join(',', _open));
        }
        catch (Exception)
        {
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
