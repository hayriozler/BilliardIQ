@using Scoreboard.WebApp.Security

<aside class="sidebar">
    <div class="brand">
        <span class="brand-mark">🎱</span>
        <span>BillardIQ</span>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="org">
                <span>Salon</span>
                <strong>@context.User.FindFirst(AuthClaims.OrganizationName)?.Value</strong>
            </div>

            <nav>
                <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-ico">📊</span>Masalar</NavLink>
                <NavLink href="/tables"><span class="nav-ico">🟩</span>Masa yönetimi</NavLink>
                <NavLink href="/pricing"><span class="nav-ico">💰</span>Fiyatlandırma</NavLink>

                <div class="nav-section">Oyuncular</div>
                <NavLink href="/players"><span class="nav-ico">🧑</span>Oyuncular</NavLink>
                <NavLink href="/clubs"><span class="nav-ico">🏛️</span>Kulüpler</NavLink>
                <NavLink href="/teams"><span class="nav-ico">👥</span>Takımlar</NavLink>

                <div class="nav-section">Sistem</div>
                <NavLink href="/devices"><span class="nav-ico">📟</span>Cihazlar</NavLink>
                @if (context.User.IsInRole(nameof(StaffRole.Owner)) || context.User.IsInRole(nameof(StaffRole.Manager)))
                {
                    <NavLink href="/staff"><span class="nav-ico">🔑</span>Kullanıcılar</NavLink>
                }
            </nav>

            <div class="user-box">
                <strong>@context.User.Identity?.Name</strong>
                <span>@string.Join(", ", context.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</span>
                <form method="post" action="/logout">
                    <button type="submit">Çıkış yap</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</aside>
