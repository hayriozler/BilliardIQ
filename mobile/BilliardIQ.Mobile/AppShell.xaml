<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BillardIQ.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:games="clr-namespace:BillardIQ.Mobile.Pages.Games"
    xmlns:players="clr-namespace:BillardIQ.Mobile.Pages.Players"
    xmlns:play="clr-namespace:BillardIQ.Mobile.Pages.Play"
    xmlns:connection="clr-namespace:BillardIQ.Mobile.Pages.Connection"
    xmlns:scoreboard="clr-namespace:BillardIQ.Mobile.Pages.Scoreboard"
    xmlns:admin="clr-namespace:BillardIQ.Mobile.Pages.Admin"
    xmlns:stats="clr-namespace:BillardIQ.Mobile.Pages.Stats"
    xmlns:ssh="clr-namespace:BillardIQ.Mobile.Pages.Ssh"
    Shell.FlyoutBehavior="Flyout"
    Title="BilliardIQ">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate games:GameListViewPage}"
        Route="home" />

    <ShellContent
        Title="Game"
        ContentTemplate="{DataTemplate play:GamePlayViewPage}"
        Route="game" />

    <FlyoutItem Title="Scoreboard Admin">
        <Tab Title="Score">
            <ShellContent
                ContentTemplate="{DataTemplate scoreboard:ScoreboardViewPage}"
                Route="scoreboard" />
        </Tab>
        <Tab Title="Teams">
            <ShellContent
                ContentTemplate="{DataTemplate admin:TeamListViewPage}"
                Route="admin-teams" />
        </Tab>
        <Tab Title="Players">
            <ShellContent
                ContentTemplate="{DataTemplate admin:PlayerListViewPage}"
                Route="admin-player" />
        </Tab>
        <Tab Title="Stats">
            <ShellContent
                ContentTemplate="{DataTemplate stats:PlayerStatsListViewPage}"
                Route="admin-stats" />
        </Tab>
        <Tab Title="SSH">
            <ShellContent
                ContentTemplate="{DataTemplate ssh:SshConsoleViewPage}"
                Route="admin-ssh" />
        </Tab>
    </FlyoutItem>

    <ShellContent
        Title="Connection"
        ContentTemplate="{DataTemplate connection:ConnectionViewPage}"
        Route="connect"
        Shell.FlyoutItemIsVisible="False" />

    <ShellContent
        Title="Profile"
        ContentTemplate="{DataTemplate players:PlayerProfileViewPage}"
        Route="profile" />

</Shell>
