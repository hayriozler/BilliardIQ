<?xml version="1.0" encoding="utf-8" ?>
<basePages:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:basePages="clr-namespace:BilliardIQ.Mobile.Pages.BasePages"
    xmlns:pageModels="clr-namespace:BilliardIQ.Mobile.PageModels.Auth"
    x:DataType="pageModels:ForgotPasswordPageModel"
    x:Class="BilliardIQ.Mobile.Pages.Auth.ForgotPasswordViewPage"
    x:Name="ForgotPasswordPage"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="{Binding L[Forgot_Title]}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Source={x:Reference Name=ForgotPasswordPage}, Path=BindingContext}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">

            <Label Text="{Binding L[Forgot_Title]}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="{Binding L[Forgot_Hint]}" FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />

            <Entry Text="{Binding Email, Mode=TwoWay}"
                   Placeholder="{Binding L[Auth_Email]}"
                   Keyboard="Email"
                   IsEnabled="{Binding IsEmailStep}" />

            <Button Text="{Binding L[Forgot_SendCode]}"
                    Command="{Binding SendCodeCommand}"
                    IsVisible="{Binding IsEmailStep}"
                    IsEnabled="{Binding IsIdle}" />

            <VerticalStackLayout Spacing="14" IsVisible="{Binding CodeSent}">
                <Entry Text="{Binding Code, Mode=TwoWay}"
                       Placeholder="{Binding L[Forgot_Code]}"
                       Keyboard="Numeric"
                       MaxLength="6" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding NewPassword, Mode=TwoWay}"
                           Placeholder="{Binding L[Pwd_New]}"
                           IsPassword="{Binding IsPasswordHidden}" />
                    <Button Grid.Column="1"
                            Text="{Binding PasswordToggleGlyph}"
                            Command="{Binding TogglePasswordCommand}"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            FontSize="20"
                            Padding="8,0"
                            VerticalOptions="Center" />
                </Grid>
                <Entry Text="{Binding ConfirmPassword, Mode=TwoWay}"
                       Placeholder="{Binding L[Pwd_Confirm]}"
                       IsPassword="{Binding IsPasswordHidden}" />
                <Button Text="{Binding L[Forgot_Submit]}"
                        Command="{Binding ResetPasswordCommand}"
                        IsEnabled="{Binding IsIdle}" />
            </VerticalStackLayout>

            <Label Text="{Binding Message}" FontSize="13" IsVisible="{Binding HasMessage}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding MessageIsError}" Value="True">
                        <Setter Property="TextColor" Value="Red" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding MessageIsError}" Value="False">
                        <Setter Property="TextColor" Value="Green" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="{Binding L[Forgot_Back]}"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</basePages:BasePage>
