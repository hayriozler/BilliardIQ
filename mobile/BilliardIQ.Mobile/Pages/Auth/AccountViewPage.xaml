<?xml version="1.0" encoding="utf-8" ?>
<basePages:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:basePages="clr-namespace:BilliardIQ.Mobile.Pages.BasePages"
    xmlns:pageModels="clr-namespace:BilliardIQ.Mobile.PageModels.Auth"
    x:DataType="pageModels:AccountPageModel"
    x:Class="BilliardIQ.Mobile.Pages.Auth.AccountViewPage"
    x:Name="AccountPage"
    Title="{Binding L[Account_Title]}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Source={x:Reference Name=AccountPage}, Path=BindingContext}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Border BackgroundColor="#1E3A5F" StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding DisplayName}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding Email}" FontSize="14" TextColor="#90CAF9" />
                    <Label Text="{Binding Role}" FontSize="13" TextColor="#FFD54F" />
                    <Label Text="{Binding OrganizationName}" FontSize="13" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsPlayer}">
                <Grid WidthRequest="110" HeightRequest="110" HorizontalOptions="Center">
                    <Image Source="{Binding Picture}" IsVisible="{Binding HasPicture}" Aspect="AspectFill" />
                    <Border IsVisible="{Binding HasNoPicture}" StrokeThickness="0" BackgroundColor="#90A4AE">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="55" />
                        </Border.StrokeShape>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="8" RowSpacing="8">
                    <Button Grid.Row="0" Grid.Column="0" Text="{Binding L[Account_TakePhoto]}" Command="{Binding TakePhotoCommand}" />
                    <Button Grid.Row="0" Grid.Column="1" Text="{Binding L[Account_ChoosePhoto]}" Command="{Binding ChoosePhotoCommand}" />
                    <Button Grid.Row="1" Grid.Column="0" Text="{Binding L[Account_ChooseAvatar]}" Command="{Binding PickAvatarCommand}" />
                    <Button Grid.Row="1" Grid.Column="1" Text="{Binding L[Account_RemovePhoto]}" Command="{Binding RemovePhotoCommand}"
                            BackgroundColor="Gray" />
                </Grid>

                <Label Text="{Binding L[Account_Name]}" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding FullName}" FontSize="16" />
                <Label Text="{Binding L[Account_Nickname]}" FontSize="12" TextColor="Gray" />
                <Entry Text="{Binding Nickname, Mode=TwoWay}" MaxLength="50" />
                <Label Text="{Binding L[Account_Level]}" FontSize="12" TextColor="Gray" />
                <Picker ItemsSource="{Binding LevelNames}" SelectedIndex="{Binding LevelIndex, Mode=TwoWay}" />
                <Label Text="{Binding L[Account_LicenseNo]}" FontSize="12" TextColor="Gray" />
                <Entry Text="{Binding LicenseNo, Mode=TwoWay}" MaxLength="50" />
                <Label Text="{Binding L[Account_LicenseValidUntil]}" FontSize="12" TextColor="Gray" />
                <Entry Text="{Binding LicenseValidUntil, Mode=TwoWay}" Placeholder="yyyy-MM-dd" Keyboard="Numeric" />
                <Label Text="{Binding L[Account_BirthDate]}" FontSize="12" TextColor="Gray" />
                <Entry Text="{Binding BirthDate, Mode=TwoWay}" Placeholder="yyyy-MM-dd" Keyboard="Numeric" />
                <Label Text="{Binding L[Account_Gender]}" FontSize="12" TextColor="Gray" />
                <Picker ItemsSource="{Binding GenderNames}" SelectedIndex="{Binding GenderIndex, Mode=TwoWay}" />
                <Label Text="{Binding L[Account_Handedness]}" FontSize="12" TextColor="Gray" />
                <Picker ItemsSource="{Binding HandednessNames}" SelectedIndex="{Binding HandednessIndex, Mode=TwoWay}" />

                <Label Text="{Binding L[Account_ShortcutNumber]}" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding ShortcutNumber}" FontSize="16" />
                <Label Text="{Binding L[Account_Association]}" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding Association}" FontSize="16" />
                <Label Text="{Binding L[Account_Location]}" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding Location}" FontSize="16" />
                <Label Text="{Binding L[Account_Clubs]}" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding Clubs}" FontSize="16" />
                <Label Text="{Binding L[Account_Teams]}" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding Teams}" FontSize="16" />
            </VerticalStackLayout>

            <Label Text="{Binding L[Account_DisplayName]}" FontSize="12" TextColor="Gray" IsVisible="{Binding IsPlayer, Converter={toolkit:InvertedBoolConverter}}" />
            <Entry Text="{Binding DisplayName, Mode=TwoWay}" MaxLength="100" IsVisible="{Binding IsPlayer, Converter={toolkit:InvertedBoolConverter}}" />

            <Label Text="{Binding L[Account_Phone]}" FontSize="12" TextColor="Gray" />
            <Entry Text="{Binding Phone, Mode=TwoWay}" Keyboard="Telephone" MaxLength="30" />
            <Label Text="{Binding L[Account_Language]}" FontSize="12" TextColor="Gray" />
            <Picker ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />

            <Button Text="{Binding L[Account_Save]}"
                    Command="{Binding SaveProfileCommand}"
                    IsEnabled="{Binding IsIdle}"
                    BackgroundColor="#2E7D32" TextColor="White" />

            <Button Text="{Binding L[Account_ChangeOrganization]}"
                    Command="{Binding ChangeOrganizationCommand}"
                    IsVisible="{Binding CanSwitchOrganization}" />
            <Button Text="{Binding L[Account_ChangePassword]}"
                    Command="{Binding ChangePasswordCommand}" />

            <Label Text="{Binding L[Account_ChangeEmail]}" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry Text="{Binding NewEmail, Mode=TwoWay}"
                   Placeholder="{Binding L[Account_NewEmail]}"
                   Keyboard="Email" />
            <Entry Text="{Binding EmailPassword, Mode=TwoWay}"
                   Placeholder="{Binding L[Pwd_Current]}"
                   IsPassword="True" />
            <Button Text="{Binding L[Account_ChangeEmail]}"
                    Command="{Binding ChangeEmailCommand}"
                    IsEnabled="{Binding IsIdle}" />

            <Label Text="{Binding Message}" FontSize="13" IsVisible="{Binding HasMessage}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding MessageIsError}" Value="True">
                        <Setter Property="TextColor" Value="Red" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding MessageIsError}" Value="False">
                        <Setter Property="TextColor" Value="Green" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Button Text="{Binding L[Account_SignOut]}"
                    Command="{Binding SignOutCommand}"
                    BackgroundColor="Red"
                    TextColor="White"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</basePages:BasePage>
