<basePages:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:basePages="clr-namespace:BilliardIQ.Mobile.Pages.BasePages"
    xmlns:vm="clr-namespace:BilliardIQ.Mobile.PageModels.Analyzers"
    xmlns:local="clr-namespace:BilliardIQ.Mobile.Pages.Analyzers"
    x:Class="BilliardIQ.Mobile.Pages.Analyzers.PhotoAnalyzerViewPage"
    x:DataType="vm:PhotoAnalyzerPageModel">

    <Grid BackgroundColor="Black">

        <!-- Full-screen camera preview -->
        <toolkit:CameraView x:Name="Camera"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        SelectedCamera="{Binding SelectedCamera}"/>

        <!-- Transparent gesture overlay: pinch-to-zoom + tap-to-focus -->
        <Grid x:Name="cameraOverlay"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              BackgroundColor="#01000000">
            <Grid.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated"/>
                <TapGestureRecognizer Tapped="OnCameraViewTapped"/>
            </Grid.GestureRecognizers>

            <!-- Focus indicator -->
            <Border x:Name="focusIndicator"
                    IsVisible="False"
                    WidthRequest="72" HeightRequest="72"
                    StrokeShape="RoundRectangle 4"
                    Stroke="White" StrokeThickness="2"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- Close button — top left -->
        <Button Text="✕"
                FontSize="22" BackgroundColor="#60000000" TextColor="White"
                CornerRadius="24" WidthRequest="48" HeightRequest="48"
                Padding="0" HorizontalOptions="Start" VerticalOptions="Start"
                Margin="12,48,0,0" Clicked="OnCloseClicked"/>

        <!-- Bottom bar: photo strip + capture controls -->
        <Grid VerticalOptions="End" HorizontalOptions="Fill">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- delete action row -->
                <RowDefinition Height="100"/>    <!-- photo strip -->
                <RowDefinition Height="110"/>    <!-- capture controls -->
            </Grid.RowDefinitions>

            <BoxView Grid.Row="1" BackgroundColor="#88000000"/>
            <BoxView Grid.Row="2" BackgroundColor="#FF000000"/>

            <!-- Delete action (visible when a photo is selected in strip) -->
            <Grid Grid.Row="0"
                  x:Name="photoActions"
                  IsVisible="False"
                  Padding="12,6"
                  BackgroundColor="#88000000"
                  HorizontalOptions="Start">
                <Button Text="🗑"
                        BackgroundColor="#CC3333" TextColor="White"
                        CornerRadius="8" HeightRequest="34" WidthRequest="52"
                        FontSize="14" Padding="0" Clicked="OnDeletePhoto"/>
            </Grid>

            <!-- Horizontal photo strip: tıklanınca tam ekran açılır -->
            <CollectionView Grid.Row="1"
                            x:Name="photoStrip"
                            SelectionMode="Single"
                            SelectionChanged="OnPhotoSelected"
                            Margin="8,8">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:CapturedPhoto">
                        <Border WidthRequest="80" HeightRequest="80"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="2" Stroke="White"
                                BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="LimeGreen"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Image Source="{Binding Source}" Aspect="AspectFill"
                                   WidthRequest="80" HeightRequest="80"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Capture button — centered -->
            <Border x:Name="captureButton"
                    Grid.Row="2"
                    IsEnabled="False" Opacity="0.4"
                    WidthRequest="80" HeightRequest="80"
                    StrokeShape="RoundRectangle 40"
                    Stroke="White" StrokeThickness="4"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartCaptureCommand}"/>
                </Border.GestureRecognizers>
                <Ellipse Fill="White" WidthRequest="62" HeightRequest="62"
                         HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════
             TAM EKRAN FOTO GÖRÜNTÜLEYICI
             Fotoğraf çekince veya strip'ten bir küçük resme tıklanınca açılır.
             ═══════════════════════════════════════════════════════════════════ -->
        <Grid x:Name="photoViewer" IsVisible="False" BackgroundColor="Black">

            <!-- Fotoğraf (analiz sonrası annotated görüntüyle değiştirilir) -->
            <Image x:Name="fullPhoto"
                   Aspect="AspectFit"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"/>

            <!-- Analiz sırasında gösterilen yükleme bindirmesi -->
            <Grid x:Name="analyzeOverlay"
                  IsVisible="False"
                  BackgroundColor="#99000000"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="16">
                    <ActivityIndicator IsRunning="True"
                                       Color="White"
                                       WidthRequest="48" HeightRequest="48"/>
                    <Label Text="Analiz ediliyor..."
                           TextColor="White" FontSize="16"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Üst bar: kapat (sol) + Analiz Et (sağ) -->
            <Grid VerticalOptions="Start" HorizontalOptions="Fill" Margin="0,44,0,0">
                <Button Text="✕"
                        FontSize="22" BackgroundColor="#60000000" TextColor="White"
                        CornerRadius="24" WidthRequest="48" HeightRequest="48"
                        Padding="0" HorizontalOptions="Start"
                        Margin="12,0,0,0"
                        Clicked="OnPhotoViewerClose"/>

                <Button x:Name="analyzeButton"
                        Text="🔍 Analiz Et"
                        FontSize="15" FontAttributes="Bold"
                        BackgroundColor="#DD0A5E14"
                        TextColor="White"
                        CornerRadius="22" HeightRequest="44"
                        Padding="18,0"
                        HorizontalOptions="End"
                        Margin="0,0,12,0"
                        Clicked="OnAnalyzeClicked"/>
            </Grid>

            <!-- Alt sonuç barı: tespit edilen top ve köşe bilgisi -->
            <Grid x:Name="analysisResultBar"
                  IsVisible="False"
                  VerticalOptions="End"
                  BackgroundColor="#EE0A1A0A"
                  Padding="16,10">
                <Label x:Name="analysisResultLabel"
                       TextColor="White"
                       FontSize="14"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </Grid>

        </Grid>

    </Grid>

</basePages:BasePage>
