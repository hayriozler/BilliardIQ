<?xml version="1.0" encoding="utf-8" ?>
<basePages:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:basePages="clr-namespace:BilliardIQ.Mobile.Pages.BasePages"
    xmlns:vm="clr-namespace:BilliardIQ.Mobile.PageModels.Debug"
    x:DataType="vm:DebugTableAnalysisPageModel"
    x:Class="BilliardIQ.Mobile.Pages.Debug.DebugTableAnalysisViewPage"
    Title="Debug · Masa Analizi">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="12">

            <!-- ─── Engine Seçimi ──────────────────────────────────────────── -->
            <Label Text="Tespit Motoru" TextColor="#AAAAAA" FontSize="12" Margin="0,4,0,0"/>
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">

                <!-- Renk (HSV eşik, en büyük blob) -->
                <Border Grid.Column="0" StrokeThickness="2" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.Stroke>
                        <Binding Path="IsColorEngine">
                            <Binding.Converter>
                                <toolkit:BoolToObjectConverter TrueObject="#64B5F6" FalseObject="#444"/>
                            </Binding.Converter>
                        </Binding>
                    </Border.Stroke>
                    <Button Text="🎨 Renk" Command="{Binding SelectColorCommand}"
                            BackgroundColor="Transparent" TextColor="White"
                            FontSize="13" HeightRequest="44"/>
                </Border>

                <!-- Hough (dairesellik filtreli) -->
                <Border Grid.Column="1" StrokeThickness="2" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.Stroke>
                        <Binding Path="IsHoughEngine">
                            <Binding.Converter>
                                <toolkit:BoolToObjectConverter TrueObject="#81C784" FalseObject="#444"/>
                            </Binding.Converter>
                        </Binding>
                    </Border.Stroke>
                    <Button Text="🔵 Hough" Command="{Binding SelectHoughCommand}"
                            BackgroundColor="Transparent" TextColor="White"
                            FontSize="13" HeightRequest="44"/>
                </Border>

                <!-- ONNX (model bazlı) -->
                <Border Grid.Column="2" StrokeThickness="2" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.Stroke>
                        <Binding Path="IsOnnxEngine">
                            <Binding.Converter>
                                <toolkit:BoolToObjectConverter TrueObject="#FFB74D" FalseObject="#444"/>
                            </Binding.Converter>
                        </Binding>
                    </Border.Stroke>
                    <Button Text="🤖 ONNX" Command="{Binding SelectOnnxCommand}"
                            BackgroundColor="Transparent" TextColor="White"
                            FontSize="13" HeightRequest="44"/>
                </Border>

            </Grid>

            <!-- Engine açıklaması -->
            <Label FontSize="11" TextColor="#888" Margin="2,0">
                <Label.Text>
                    <MultiBinding StringFormat="{}{}">
                        <!-- binding trick: engine description via converter would need code; keep simple -->
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Label FontSize="11" TextColor="#888" Margin="2,-8,2,4">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="🎨 Renk" TextColor="#64B5F6"/>
                        <Span Text=": büyük blob   "/>
                        <Span Text="🔵 Hough" TextColor="#81C784"/>
                        <Span Text=": dairesel blob (önerilen)   "/>
                        <Span Text="🤖 ONNX" TextColor="#FFB74D"/>
                        <Span Text=": model (model yoksa Hough'a düşer)"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- ─── Fotoğraf Seç ────────────────────────────────────────────── -->
            <Button Text="📷  Galeriden Fotoğraf Seç"
                    Command="{Binding PickPhotoCommand}"
                    BackgroundColor="#1E3A5F" TextColor="White"
                    CornerRadius="10" HeightRequest="50"
                    FontSize="16" FontAttributes="Bold"/>

            <!-- Orijinal fotoğraf -->
            <Border IsVisible="{Binding HasPhoto}"
                    StrokeThickness="1" Stroke="#444" HeightRequest="240">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Grid>
                    <Image Source="{Binding OriginalPhoto}" Aspect="AspectFit" BackgroundColor="Black"/>
                    <Label Text="Orijinal" TextColor="#888" FontSize="11"
                           HorizontalOptions="Start" VerticalOptions="End" Margin="8,0,0,6"/>
                </Grid>
            </Border>

            <!-- Analiz Et butonu -->
            <Button Text="🎱  Analiz Et"
                    Command="{Binding RunAnalysisCommand}"
                    IsVisible="{Binding HasPhoto}"
                    IsEnabled="{Binding IsAnalyzing, Converter={toolkit:InvertedBoolConverter}}"
                    BackgroundColor="#5E1B0A" TextColor="White"
                    CornerRadius="10" HeightRequest="50"
                    FontSize="16" FontAttributes="Bold"/>

            <!-- Yükleme -->
            <Grid IsVisible="{Binding IsAnalyzing}" HeightRequest="60">
                <ActivityIndicator IsRunning="True" Color="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                <Label Text="Analiz ediliyor..." TextColor="#AAA" FontSize="13"
                       HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,4"/>
            </Grid>

            <!-- ─── Sonuçlar ────────────────────────────────────────────────── -->
            <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="10">

                <!-- Durum -->
                <Border Padding="12,10" BackgroundColor="#0D2B0D" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Label Text="{Binding StatusMessage}"
                           TextColor="#A5D6A7" FontSize="14" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </Border>

                <!-- Annotated görüntü -->
                <Label Text="Annotated Görüntü" TextColor="#FFCC80" FontAttributes="Bold" FontSize="13"/>
                <Border StrokeThickness="1" Stroke="#FFCC80" HeightRequest="300">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Image Source="{Binding AnnotatedPhoto}" Aspect="AspectFit" BackgroundColor="Black"/>
                </Border>

                <!-- Koordinat detayları -->
                <Label Text="Koordinatlar (rel = görüntü 0-1, px = piksel)" TextColor="#90CAF9" FontAttributes="Bold" FontSize="13"/>
                <Border Padding="12" BackgroundColor="#0D1520" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Label Text="{Binding DetailText}" TextColor="#CFE8FF"
                           FontFamily="OpenSansRegular" FontSize="13" LineBreakMode="WordWrap"/>
                </Border>

                <!-- Yeniden analiz -->
                <Button Text="🔄  Yeniden Analiz Et"
                        Command="{Binding RunAnalysisCommand}"
                        BackgroundColor="#333" TextColor="White"
                        CornerRadius="10" HeightRequest="44"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</basePages:BasePage>
