<?xml version="1.0" encoding="utf-8" ?>
<basePages:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:basePages="clr-namespace:BilliardIQ.Mobile.Pages.BasePages"
    xmlns:pageModels="clr-namespace:BilliardIQ.Mobile.PageModels.ScoreboardPageModels"
    x:DataType="pageModels:ScoreboardPageModel"
    x:Class="BilliardIQ.Mobile.Pages.Scoreboard.ScoreboardViewPage"
    x:Name="Scoreboard"
    Title="{Binding L[Scoreboard_Title]}">

    <basePages:BasePage.Behaviors>
        <toolkit:EventToCommandBehavior
            x:Name="AppearingBehavior"
            BindingContext="{Binding Source={x:Reference Name=Scoreboard}, Path=BindingContext}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </basePages:BasePage.Behaviors>

    <Grid Padding="12,6" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="6">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *" ColumnSpacing="10">
            <Ellipse Grid.Column="0"
                     WidthRequest="12" HeightRequest="12"
                     Fill="{Binding ConnectionStatusColor}"
                     VerticalOptions="Center"
                     SemanticProperties.Description="{Binding ConnectionStatusText}" />

            <Button Grid.Column="1"
                    Text="{Binding L[Scoreboard_Reconnect]}"
                    Command="{Binding ReconnectCommand}"
                    IsVisible="{Binding ShowReconnect}"
                    IsEnabled="{Binding IsReconnecting, Converter={toolkit:InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="12" FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="28"
                    Padding="10,0" />

            <Button Grid.Column="2"
                    Text="{Binding L[Scoreboard_Reset]}"
                    Command="{Binding ResetScoresCommand}"
                    IsEnabled="{Binding CanInteract}"
                    HorizontalOptions="End"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    FontSize="12"
                    Padding="0" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto, 80, Auto" ColumnSpacing="10" HorizontalOptions="Center">
            <Label Grid.Column="0" Text="{Binding L[Scoreboard_MatchTarget]}"
                   FontSize="13" TextColor="Gray"
                   VerticalOptions="Center" />
            <Entry Grid.Column="1"
                   Text="{Binding MatchTarget, Mode=TwoWay}"
                   Keyboard="Numeric"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"
                   ReturnType="Done"
                   ReturnCommand="{Binding SendMatchTargetCommand}" />
            <Label Grid.Column="2" Text="{Binding Inning, StringFormat='{0:D0}. Inning'}"
                   FontSize="13" TextColor="Gray"
                   VerticalOptions="Center" Margin="10,0,0,0" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, *" ColumnSpacing="10">

            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="2">
                    <Entry Grid.Column="0"
                           Text="{Binding Player1Name, Mode=TwoWay}"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" FontSize="14"
                           TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                           BackgroundColor="Transparent"
                           ReturnType="Done"
                           ReturnCommand="{Binding ResolvePlayer1Command}" />
                    <Button Grid.Column="1"
                            ImageSource="{StaticResource IconPersonPick}"
                            Command="{Binding PickPlayer1Command}"
                            IsEnabled="{Binding CanInteract}"
                            BackgroundColor="{StaticResource Primary}"
                            CornerRadius="18"
                            WidthRequest="36" HeightRequest="36"
                            MinimumWidthRequest="36" MinimumHeightRequest="36"
                            Padding="0"
                            VerticalOptions="Center" />
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1C1C1E}"
                        Stroke="{Binding Player1StrokeColor}"
                        StrokeThickness="3" Padding="0,8"
                        SemanticProperties.Hint="{Binding L[Game_Player1]}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPlayer1Command}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding DisplayedPlayer1Score}" FontSize="26" FontAttributes="Bold"
                           LineBreakMode="NoWrap"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="{Binding Player1Average, StringFormat='Avg {0:F3}'}" FontSize="10" TextColor="Gray" />
                    <Label Text="{Binding Player1HighRun, StringFormat='HR {0}'}" FontSize="10" TextColor="Gray" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Border Grid.Column="1"
                    IsVisible="{Binding HasPendingDelta}"
                    BackgroundColor="{Binding PendingDeltaColor}"
                    StrokeThickness="0"
                    Padding="8,3"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label Text="{Binding PendingDeltaText}"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="White" />
            </Border>

            <VerticalStackLayout Grid.Column="2" Spacing="4">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="2">
                    <Button Grid.Column="0"
                            ImageSource="{StaticResource IconPersonPick}"
                            Command="{Binding PickPlayer2Command}"
                            IsEnabled="{Binding CanInteract}"
                            BackgroundColor="{StaticResource Primary}"
                            CornerRadius="18"
                            WidthRequest="36" HeightRequest="36"
                            MinimumWidthRequest="36" MinimumHeightRequest="36"
                            Padding="0"
                            VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Text="{Binding Player2Name, Mode=TwoWay}"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" FontSize="14"
                           TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                           BackgroundColor="Transparent"
                           ReturnType="Done"
                           ReturnCommand="{Binding ResolvePlayer2Command}" />
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1C1C1E}"
                        Stroke="{Binding Player2StrokeColor}"
                        StrokeThickness="3" Padding="0,8"
                        SemanticProperties.Hint="{Binding L[Game_Player2]}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPlayer2Command}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding DisplayedPlayer2Score}" FontSize="26" FontAttributes="Bold"
                           LineBreakMode="NoWrap"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="{Binding Player2Average, StringFormat='Avg {0:F3}'}" FontSize="10" TextColor="Gray" />
                    <Label Text="{Binding Player2HighRun, StringFormat='HR {0}'}" FontSize="10" TextColor="Gray" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="3">

            <Button Command="{Binding IncrementActiveScoreCommand}"
                    IsEnabled="{Binding CanInteract}"
                    Text="&#x25B2;"
                    FontSize="14"
                    WidthRequest="42" HeightRequest="42" CornerRadius="9"
                    HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light=#ECEFF1, Dark=#263238}"
                    TextColor="{AppThemeBinding Light=#37474F, Dark=White}" />

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="&#x25C0;"
                        Command="{Binding SelectPlayer1Command}"
                        IsEnabled="{Binding CanInteract}"
                        BackgroundColor="{Binding Player1ArrowColor}"
                        TextColor="White"
                        FontSize="16" FontAttributes="Bold"
                        CornerRadius="19"
                        WidthRequest="38" HeightRequest="38"
                        MinimumWidthRequest="38" MinimumHeightRequest="38"
                        VerticalOptions="Center"
                        Padding="0" />

                <Button Command="{Binding ConfirmScoreCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Text="&#x2713;"
                        SemanticProperties.Description="{Binding L[Scoreboard_Enter]}"
                        FontAttributes="Bold" FontSize="19"
                        WidthRequest="50" HeightRequest="50" CornerRadius="25"
                        HorizontalOptions="Center"
                        BackgroundColor="#2E7D32" TextColor="White" />

                <Button Text="&#x25B6;"
                        Command="{Binding SelectPlayer2Command}"
                        IsEnabled="{Binding CanInteract}"
                        BackgroundColor="{Binding Player2ArrowColor}"
                        TextColor="White"
                        FontSize="16" FontAttributes="Bold"
                        CornerRadius="19"
                        WidthRequest="38" HeightRequest="38"
                        MinimumWidthRequest="38" MinimumHeightRequest="38"
                        VerticalOptions="Center"
                        Padding="0" />
            </HorizontalStackLayout>

            <Button Command="{Binding DecrementActiveScoreCommand}"
                    IsEnabled="{Binding CanInteract}"
                    Text="&#x25BC;"
                    FontSize="14"
                    WidthRequest="42" HeightRequest="42" CornerRadius="9"
                    HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light=#ECEFF1, Dark=#263238}"
                    TextColor="{AppThemeBinding Light=#37474F, Dark=White}" />
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="4" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="{Binding TimerButtonText}"
                   FontSize="13" FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#37474F, Dark=White}" />
            <Switch IsToggled="{Binding IsTimerRunning, Mode=TwoWay}"
                    IsEnabled="{Binding CanInteract}"
                    OnColor="#2E7D32"
                    Scale="0.85" />
        </HorizontalStackLayout>

        <Grid Grid.Row="5" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Command="{Binding StartNewGameCommand}"
                    IsEnabled="{Binding CanInteract}"
                    Text="{Binding L[Scoreboard_StartNewGame]}"
                    FontAttributes="Bold" FontSize="12"
                    LineBreakMode="NoWrap"
                    HeightRequest="34" CornerRadius="8"
                    BackgroundColor="#2E7D32" TextColor="White" />

            <Button Grid.Column="1"
                    Command="{Binding EndGameCommand}"
                    IsEnabled="{Binding CanInteract}"
                    Text="{Binding L[Scoreboard_EndGame]}"
                    FontAttributes="Bold" FontSize="12"
                    LineBreakMode="NoWrap"
                    HeightRequest="34" CornerRadius="8"
                    BackgroundColor="#C62828" TextColor="White" />
        </Grid>

        <Button Grid.Row="6"
                Command="{Binding StartWarmUpCommand}"
                IsEnabled="{Binding CanInteract}"
                Text="{Binding L[Scoreboard_WarmUp]}"
                FontAttributes="Bold" FontSize="12"
                HeightRequest="32" CornerRadius="8"
                BackgroundColor="#1565C0" TextColor="White" />

    </Grid>

</basePages:BasePage>
