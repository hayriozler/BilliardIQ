@page "/login"

<h1>Club Login</h1>

@if (ShowError)
{
    <p class="error">Invalid club code.</p>
}

<form method="post" action="/login">
    <div class="form-row">
        <input type="text" name="code" placeholder="Club code" autocomplete="off" />
        <button type="submit">Log in</button>
    </div>
</form>

<p class="hint">No club yet? <a href="/clubs">Register one</a>.</p>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool ShowError => Error == "1";
}
