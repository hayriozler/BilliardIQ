<?xml version="1.0" encoding="utf-8" ?>
<basePages:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:basePages="clr-namespace:BilliardIQ.Mobile.Pages.BasePages"
    xmlns:vm="clr-namespace:BilliardIQ.Mobile.PageModels.Debug"
    x:DataType="vm:DebugTableAnalysisPageModel"
    x:Class="BilliardIQ.Mobile.Pages.Debug.DebugTableAnalysisViewPage"
    Title="Debug · Table Analysis">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="12">

            <!-- ─── Engine Selection ──────────────────────────────────────────── -->
            <Label Text="Detection Engine" TextColor="#AAAAAA" FontSize="12" Margin="0,4,0,0"/>
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">

                <!-- Color (HSV threshold, largest blob) -->
                <Border Grid.Column="0" StrokeThickness="2" Padding="0"
                        BackgroundColor="#1A1A1A" Stroke="#333333">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsColorEngine}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1D3D5F"/>
                            <Setter Property="Stroke" Value="#64B5F6"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Button Text="🎨 Color" Command="{Binding SelectColorCommand}"
                            BackgroundColor="Transparent" FontSize="13" HeightRequest="44"
                            TextColor="#777" FontAttributes="Bold">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsColorEngine}" Value="True">
                                <Setter Property="TextColor" Value="#64B5F6"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Border>

                <!-- OpenCV (EmguCV HoughCircles + findContours) -->
                <Border Grid.Column="1" StrokeThickness="2" Padding="0"
                        BackgroundColor="#1A1A1A" Stroke="#333333">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOpenCvEngine}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1A3D22"/>
                            <Setter Property="Stroke" Value="#81C784"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Button Text="🔵 OpenCV" Command="{Binding SelectOpenCvCommand}"
                            BackgroundColor="Transparent" FontSize="13" HeightRequest="44"
                            TextColor="#777" FontAttributes="Bold">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsOpenCvEngine}" Value="True">
                                <Setter Property="TextColor" Value="#81C784"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Border>

                <!-- ONNX (model-based) -->
                <Border Grid.Column="2" StrokeThickness="2" Padding="0"
                        BackgroundColor="#1A1A1A" Stroke="#333333">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOnnxEngine}" Value="True">
                            <Setter Property="BackgroundColor" Value="#3D2800"/>
                            <Setter Property="Stroke" Value="#FFB74D"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Button Text="🤖 ONNX" Command="{Binding SelectOnnxCommand}"
                            BackgroundColor="Transparent" FontSize="13" HeightRequest="44"
                            TextColor="#777" FontAttributes="Bold">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsOnnxEngine}" Value="True">
                                <Setter Property="TextColor" Value="#FFB74D"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Border>

            </Grid>

            <!-- Engine description -->
            <Label FontSize="11" TextColor="#888" Margin="2,0,2,4">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="🎨 Color" TextColor="#64B5F6"/>
                        <Span Text=": largest blob   "/>
                        <Span Text="🔵 OpenCV" TextColor="#81C784"/>
                        <Span Text=": HoughCircles + findContours (recommended)   "/>
                        <Span Text="🤖 ONNX" TextColor="#FFB74D"/>
                        <Span Text=": model (falls back to Color if missing)"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- ─── Pick Photo ────────────────────────────────────────────────── -->
            <Button Text="📷  Pick Photo from Gallery"
                    Command="{Binding PickPhotoCommand}"
                    BackgroundColor="#1E3A5F" TextColor="White"
                    CornerRadius="10" HeightRequest="50"
                    FontSize="16" FontAttributes="Bold"/>

            <!-- Original photo -->
            <Border IsVisible="{Binding HasPhoto}"
                    StrokeThickness="1" Stroke="#444" HeightRequest="240">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <Grid>
                    <Image Source="{Binding OriginalPhoto}" Aspect="AspectFit" BackgroundColor="Black"/>
                    <Label Text="Original" TextColor="#888" FontSize="11"
                           HorizontalOptions="Start" VerticalOptions="End" Margin="8,0,0,6"/>
                </Grid>
            </Border>

            <!-- Analyze button -->
            <Button Text="🎱  Analyze"
                    Command="{Binding RunAnalysisCommand}"
                    IsVisible="{Binding HasPhoto}"
                    IsEnabled="{Binding IsAnalyzing, Converter={toolkit:InvertedBoolConverter}}"
                    BackgroundColor="#5E1B0A" TextColor="White"
                    CornerRadius="10" HeightRequest="50"
                    FontSize="16" FontAttributes="Bold"/>

            <!-- Loading -->
            <Grid IsVisible="{Binding IsAnalyzing}" HeightRequest="60">
                <ActivityIndicator IsRunning="True" Color="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                <Label Text="Analyzing..." TextColor="#AAA" FontSize="13"
                       HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,4"/>
            </Grid>

            <!-- ─── Results ──────────────────────────────────────────────────── -->
            <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="10">

                <!-- Status -->
                <Border Padding="12,10" BackgroundColor="#0D2B0D" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Label Text="{Binding StatusMessage}"
                           TextColor="#A5D6A7" FontSize="14" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </Border>

                <!-- Annotated image -->
                <Label Text="Annotated Image" TextColor="#FFCC80" FontAttributes="Bold" FontSize="13"/>
                <Border StrokeThickness="1" Stroke="#FFCC80" HeightRequest="300">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Image Source="{Binding AnnotatedPhoto}" Aspect="AspectFit" BackgroundColor="Black"/>
                </Border>

                <!-- Coordinates -->
                <Label Text="Coordinates (rel = 0–1, px = pixels)" TextColor="#90CAF9" FontAttributes="Bold" FontSize="13"/>
                <Border Padding="12" BackgroundColor="#0D1520" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Label Text="{Binding DetailText}" TextColor="#CFE8FF"
                           FontFamily="OpenSansRegular" FontSize="13" LineBreakMode="WordWrap"/>
                </Border>

                <!-- Re-analyze -->
                <Button Text="🔄  Re-analyze"
                        Command="{Binding RunAnalysisCommand}"
                        BackgroundColor="#333" TextColor="White"
                        CornerRadius="10" HeightRequest="44"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</basePages:BasePage>
