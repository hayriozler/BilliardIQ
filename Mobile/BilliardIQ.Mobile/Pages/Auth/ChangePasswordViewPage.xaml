<?xml version="1.0" encoding="utf-8" ?>
<basePages:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:basePages="clr-namespace:BilliardIQ.Mobile.Pages.BasePages"
    xmlns:pageModels="clr-namespace:BilliardIQ.Mobile.PageModels.Auth"
    x:DataType="pageModels:ChangePasswordPageModel"
    x:Class="BilliardIQ.Mobile.Pages.Auth.ChangePasswordViewPage"
    x:Name="ChangePasswordPage"
    Shell.FlyoutBehavior="Disabled"
    Title="{Binding L[Pwd_Title]}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Source={x:Reference Name=ChangePasswordPage}, Path=BindingContext}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="{Binding L[Pwd_Forced]}" TextColor="DarkOrange" FontSize="14"
                   IsVisible="{Binding IsForced}" />

            <Entry Text="{Binding CurrentPassword, Mode=TwoWay}"
                   Placeholder="{Binding L[Pwd_Current]}"
                   IsPassword="True"
                   IsEnabled="{Binding IsIdle}" />
            <Entry Text="{Binding NewPassword, Mode=TwoWay}"
                   Placeholder="{Binding L[Pwd_New]}"
                   IsPassword="True"
                   IsEnabled="{Binding IsIdle}" />
            <Entry Text="{Binding ConfirmPassword, Mode=TwoWay}"
                   Placeholder="{Binding L[Pwd_Confirm]}"
                   IsPassword="True"
                   IsEnabled="{Binding IsIdle}"
                   ReturnCommand="{Binding SubmitCommand}" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="13"
                   IsVisible="{Binding HasError}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="{Binding L[Pwd_Submit]}"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsIdle}" />
            <Button Text="{Binding L[Action_Cancel]}"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding CanCancel}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</basePages:BasePage>
