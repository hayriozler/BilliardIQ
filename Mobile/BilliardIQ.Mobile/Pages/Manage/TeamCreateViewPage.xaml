<?xml version="1.0" encoding="utf-8" ?>
<basePages:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:basePages="clr-namespace:BilliardIQ.Mobile.Pages.BasePages"
    xmlns:pageModels="clr-namespace:BilliardIQ.Mobile.PageModels.Manage"
    x:DataType="pageModels:TeamCreatePageModel"
    x:Class="BilliardIQ.Mobile.Pages.Manage.TeamCreateViewPage"
    x:Name="TeamCreatePage"
    Shell.FlyoutBehavior="Disabled"
    Title="{Binding L[Create_NewTeam]}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Source={x:Reference Name=TeamCreatePage}, Path=BindingContext}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Grid WidthRequest="110" HeightRequest="110" HorizontalOptions="Center">
                <Image Source="{Binding Picture}" IsVisible="{Binding HasPicture}" Aspect="AspectFill" />
                <Border IsVisible="{Binding HasNoPicture}" StrokeThickness="0" BackgroundColor="#90A4AE">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="55" />
                    </Border.StrokeShape>
                </Border>
            </Grid>
            <Button Text="{Binding L[Account_ChooseAvatar]}" Command="{Binding PickAvatarCommand}" />

            <Label Text="{Binding L[Create_TeamName]}" FontSize="12" TextColor="Gray" />
            <Entry Text="{Binding Name, Mode=TwoWay}" MaxLength="200" />
            <Label Text="{Binding L[Create_Club]}" FontSize="12" TextColor="Gray" />
            <Picker ItemsSource="{Binding ClubNames}" SelectedIndex="{Binding ClubIndex, Mode=TwoWay}" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="13" IsVisible="{Binding HasError}" />

            <Button Text="{Binding L[Account_Save]}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsIdle}"
                    BackgroundColor="#2E7D32" TextColor="White" />
            <Button Text="{Binding L[Action_Cancel]}"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</basePages:BasePage>
