<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>59547513-7313-40f3-88ab-3e7c82edc87e</UserSecretsId>
  </PropertyGroup>

  <!-- publish-pi/ is git-ignored publish output (it can hold stray source copies); never compile it -->
  <ItemGroup>
    <Compile Remove="publish-pi/**" />
    <Content Remove="publish-pi/**" />
    <EmbeddedResource Remove="publish-pi/**" />
    <None Remove="publish-pi/**" />
  </ItemGroup>

  <!-- The avatar artwork is shared with the panel (Scoreboard.WebApp) so both draw the same picture for an avatar id -->
  <ItemGroup>
    <EmbeddedResource Include="..\Scoreboard.WebApp\Avatars\animals.json" LogicalName="Avatars.animals.json" Link="Avatars\animals.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.LocalStorage" Version="10.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\Localization\en.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\Localization\nl.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\Localization\tr.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Scoreboard.WebApp\Common\AvatarGenerator.cs" Link="Common\AvatarGenerator.cs" />
    <Using Include="Scoreboard.Common" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\Db\" />
  </ItemGroup>

</Project>
