@page "/"
@implements IAsyncDisposable
@inject LocalizationService L
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DataContext DbContext
@inject SystemPowerService SystemPower
@inject BoardSessionGuard BoardSession
@inject BoardSessionTracker BoardTracker
@inject LanguageSync LanguageSync
@inject StartupGate Startup
@inject ServerClock Clock
@inject Microsoft.Extensions.Logging.ILogger<Home> Logger
@inject Microsoft.Extensions.Options.IOptions<RemoteSyncOptions> SyncOptions
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using Scoreboard.Client.Models
@using Scoreboard.Client.Services

@if (_boardOccupiedElsewhere)
{
    <div class="board-occupied">
        <div class="board-occupied-message">@L.T("BoardOccupiedElsewhere")</div>
        <button class="board-takeover" @onclick="TakeOverBoard">@L.T("TakeOverBoard")</button>
    </div>
}
else
{
<div @ref="board" class="board" tabindex="0" @onkeydown="HandleKeyDown" @onkeydown:preventDefault="AnyDialogOpen" @onkeyup="HandleKeyUp" @onclick="RequestFullscreenAsync">

    <header class="board-header">
        <div class="header-clock">@Clock.Now.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
        <div class="header-brand">
            <img class="header-logo" src="images/zeymera-ram.png" alt="Zeymera" />
            <span class="header-brand-label">Zeymera</span>
        </div>

        <div class="header-title-group">
            @if (!string.IsNullOrEmpty(_organizationName))
            {
                <div class="header-org">@_organizationName</div>
            }
            <h1 class="title">@L.T("Title")</h1>
            <div class="balls" aria-hidden="true">
                <span class="ball yellow"></span>
                <span class="ball white"></span>
                <span class="ball red"></span>
            </div>
        </div>

        <div class="header-brand">
            <img class="header-logo" src="images/zeymera-ram.png" alt="Zeymera" />
            <span class="header-brand-label">Zeymera</span>
        </div>
        <div class="header-clock right">@Clock.Now.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</div>
    </header>

    <main class="scores">
        <section class="player-panel @(Current.ActivePlayer == 1 ? "active-white" : "")" data-slot="1">
            <div class="player-name-bar">
                <div class="player-name-content">
                    @if (Current.ActivePlayer == 1)
                    {
                        <span class="ball white turn-ball" aria-hidden="true"></span>
                    }
                    <span>@GetHeaderLabel(1)</span>
                    @if (GetImageSource(1) is { } image1)
                    {
                        <img class="player-photo" src="@image1" alt="" />
                    }
                    else
                    {
                        <div class="player-avatar-fallback" style="background:@GetAvatarColor(1)">@GetAvatarInitials(1)</div>
                    }
                </div>
                @if (Current.ActivePlayer == 1)
                {
                    <span class="current-points-badge">@Current.CurrentPoints</span>
                }
            </div>
            @if (GetTeamName(1) is { } teamName1)
            {
                <div class="player-team">
                    @if (GetTeamAvatarDataUri(1) is { } teamAvatar1)
                    {
                        <img class="team-avatar" src="@teamAvatar1" alt="" />
                    }
                    <span>@teamName1</span>
                </div>
            }
            <div class="player-score">@Current.Player1Score</div>
            @if ((Current.IsHandicap || Current.ActivePlayer == 1) && PointsToGo(1) is int nog1)
            {
                <div class="nog-indicator">@string.Format(L.T("PointsToGo"), nog1)</div>
            }
        </section>

        <section class="center-panel">
            <div class="center-row">
                <span class="center-label">@L.T("Inning")</span>
                <span class="center-value inning">@Current.Inning</span>
            </div>
            <div class="center-divider"></div>
            <div class="center-row">
                <span class="center-label">@L.T("ShotClock")</span>
                <span class="center-value @(Current.ShotClockActive && Current.ShotClockRemaining <= 10 ? "urgent" : "")">@ShotClockDisplaySeconds</span>
            </div>
        </section>

        <section class="player-panel @(Current.ActivePlayer == 2 ? "active-yellow" : "")" data-slot="2">
            <div class="player-name-bar">
                <div class="player-name-content">
                    @if (Current.ActivePlayer == 2)
                    {
                        <span class="ball yellow turn-ball" aria-hidden="true"></span>
                    }
                    <span>@GetHeaderLabel(2)</span>
                    @if (GetImageSource(2) is { } image2)
                    {
                        <img class="player-photo" src="@image2" alt="" />
                    }
                    else
                    {
                        <div class="player-avatar-fallback" style="background:@GetAvatarColor(2)">@GetAvatarInitials(2)</div>
                    }
                </div>
                @if (Current.ActivePlayer == 2)
                {
                    <span class="current-points-badge">@Current.CurrentPoints</span>
                }
            </div>
            @if (GetTeamName(2) is { } teamName2)
            {
                <div class="player-team">
                    @if (GetTeamAvatarDataUri(2) is { } teamAvatar2)
                    {
                        <img class="team-avatar" src="@teamAvatar2" alt="" />
                    }
                    <span>@teamName2</span>
                </div>
            }
            <div class="player-score yellow">@Current.Player2Score</div>
            @if ((Current.IsHandicap || Current.ActivePlayer == 2) && PointsToGo(2) is int nog2)
            {
                <div class="nog-indicator">@string.Format(L.T("PointsToGo"), nog2)</div>
            }
        </section>
    </main>

    <footer class="stat-bar">
        <div class="stat-group">
            <div class="stat">
                <span class="stat-label">@L.T("Player1Avg")</span>
                <span class="stat-value">@Current.Player1Avg.ToString("0.000")</span>
            </div>
            <div class="stat">
                <span class="stat-label">@L.T("HighRun")</span>
                <span class="stat-value">@Current.Player1HighRun</span>
            </div>
        </div>
        <div class="stat-group">
            <div class="stat">
                <span class="stat-label">@L.T("Match")@if (Current.IsHandicap){<span class="hcp-badge">@L.T("HandicapShort")</span>}</span>
                @if (Current.IsHandicap)
                {
                    <span class="stat-value current handicap-targets">
                        <span>@Current.Player1Target</span><span class="handicap-divider"></span><span>@Current.Player2Target</span>
                    </span>
                }
                else
                {
                    <span class="stat-value current">@Current.MatchTarget</span>
                }
            </div>
        </div>
        <div class="stat-group">
            <div class="stat">
                <span class="stat-label">@L.T("Player2Avg")</span>
                <span class="stat-value">@Current.Player2Avg.ToString("0.000")</span>
            </div>
            <div class="stat">
                <span class="stat-label">@L.T("HighRun")</span>
                <span class="stat-value">@Current.Player2HighRun</span>
            </div>
        </div>
    </footer>

    <div class="shot-clock @(Current.ShotClockActive ? "active" : "") @(Current.ShotClockActive && Current.ShotClockRemaining <= 10 ? "urgent" : "")">
        <div class="shot-clock-bar" style="width:@(ShotClockPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
    </div>

    @if (_showControls)
    {
        <div class="controls-overlay" inert="@AnyDialogOpen" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            <div class="control-group">
                <span>@L.T("P1")</span>
                @if (GetImageSource(1) is { } imageControl1)
                {
                    <img class="player-photo" src="@imageControl1" alt="" />
                }
                else
                {
                    <div class="player-avatar-fallback" style="background:@GetAvatarColor(1)">@GetAvatarInitials(1)</div>
                }
                <input type="text" value="@Current.Player1Name" placeholder="@L.T("Player1Label")"
                       @onchange="e => DispatchAsync(ScoreboardCommand.RenamePlayer1, e.Value?.ToString())" />
                <button @onclick="() => OpenPlayerPicker(1)">@L.T("ChoosePlayer")</button>
            </div>
            <div class="control-group">
                <span>@L.T("P2")</span>
                @if (GetImageSource(2) is { } imageControl2)
                {
                    <img class="player-photo" src="@imageControl2" alt="" />
                }
                else
                {
                    <div class="player-avatar-fallback" style="background:@GetAvatarColor(2)">@GetAvatarInitials(2)</div>
                }
                <input type="text" value="@Current.Player2Name" placeholder="@L.T("Player2Default")"
                       @onchange="e => DispatchAsync(ScoreboardCommand.RenamePlayer2, e.Value?.ToString())" />
                <button @onclick="() => OpenPlayerPicker(2)">@L.T("ChoosePlayer")</button>
            </div>
            <div class="control-group">
                <span>@L.T("Match")</span>
                @if (Current.IsHandicap)
                {
                    <span>@L.T("P1")</span>
                    <input type="number" class="match-target" min="@MinHandicapTarget" max="@MaxHandicapTarget" step="1" inputmode="numeric"
                           @key="(1, _matchInputKey)" value="@Current.Player1Target"
                           @onchange="e => SetPlayerTargetFromInputAsync(1, e.Value?.ToString())" />
                    <span>@L.T("P2")</span>
                    <input type="number" class="match-target" min="@MinHandicapTarget" max="@MaxHandicapTarget" step="1" inputmode="numeric"
                           @key="(2, _matchInputKey)" value="@Current.Player2Target"
                           @onchange="e => SetPlayerTargetFromInputAsync(2, e.Value?.ToString())" />
                }
                else
                {
                    <input type="number" class="match-target" min="@MinMatchTarget" max="@MaxMatchTarget" step="1" inputmode="numeric"
                           @key="_matchInputKey" value="@Current.MatchTarget"
                           @onchange="e => SetMatchTargetFromInputAsync(e.Value?.ToString())" />
                }
                <button class="@(Current.IsHandicap ? "active" : "")" @onclick="() => DispatchAsync(ScoreboardCommand.ToggleHandicap)">@L.T("HandicapShort")</button>
            </div>
            <div class="control-group">
                <span>@L.T("ShotClock")</span>
                @if (Current.ShotClockActive)
                {
                    <button @onclick="() => DispatchAsync(ScoreboardCommand.ToggleShotClock)">@L.T("Stop")</button>
                }
                else
                {
                    <button @onclick="() => DispatchAsync(ScoreboardCommand.ToggleShotClock)">@L.T("Start")</button>
                }
                <button @onclick="() => DispatchAsync(ScoreboardCommand.ResetShotClock)">@L.T("Reset")</button>
            </div>
            <div class="control-group">
                <button @onclick="OpenWarmupPicker">@L.T("WarmUp")</button>
            </div>
            <div class="control-group">
                <span>@L.T("Language")</span>
                    <select value="@L.GetLang" @onchange="OnLanguageChanged">
                    <option value="tr">TR</option>
                    <option value="en">EN</option>
                    <option value="nl">NL</option>
                </select>
            </div>
            <div class="control-group">
                <button @onclick="() => DispatchAsync(ScoreboardCommand.NewGame)">@L.T("NewGame")</button>
            </div>
            <p class="hint">@L.T("ControlsHint")</p>
        </div>
        <div class="version-tag">@AppVersion</div>
    }

    @if (_notice is not null)
    {
        <div class="notice-toast" role="alert">@_notice</div>
    }

    @if (_showMatchEnd)
    {
        <div class="player-picker-overlay" @onclick:stopPropagation="true">
            <div class="player-picker-dialog">
                <h3>@L.T("MatchTargetReached")</h3>
                <p class="picker-empty">@string.Format(L.T("MatchTargetReachedText"), GetDisplayName(MatchLeaderSlot), TargetOf(MatchLeaderSlot))</p>
                <div class="warmup-picker-options match-end-options">
                    <button @onclick="() => DispatchAsync(ScoreboardCommand.ExtendMatch, 5)">+5 &rarr; @ExtendedLabel(5) <small>[5]</small></button>
                    <button @onclick="() => DispatchAsync(ScoreboardCommand.ExtendMatch, 10)">+10 &rarr; @ExtendedLabel(10) <small>[0]</small></button>
                    <button @onclick="() => DispatchAsync(ScoreboardCommand.NewGame)">@L.T("NewGame") <small>[*]</small></button>
                </div>
                <button class="picker-close" @onclick="() => _showMatchEnd = false">@L.T("Close") <small>[Del]</small></button>
            </div>
        </div>
    }

    @if (_showPlayerPicker is { } slot)
    {
        <div class="player-picker-overlay" @onclick:stopPropagation="true">
            <div class="player-picker-dialog">
                <h3>@L.T(slot == 1 ? "P1" : "P2")</h3>
                <div class="picker-buffer">@(_pickerBuffer.Length > 0 ? _pickerBuffer : L.T("ShortcutNumberHint"))</div>
                @if (_rosterPlayers.Count == 0)
                {
                    <p class="picker-empty">@L.T("NoPlayersInRoster")</p>
                }
                else
                {
                    <div class="picker-list">
                        @foreach (var p in _rosterPlayers)
                        {
                            var taken = IsTakenByOtherSide(slot, p.Id);
                            <button class="picker-row @(taken ? "taken" : "") @(p.Id == HighlightedPlayerId ? "active" : "")" disabled="@taken" title="@(taken ? L.T("PlayerAlreadySelected") : null)"
                                    @onclick="() => DispatchAsync(slot == 1 ? ScoreboardCommand.SelectRosterPlayer1 : ScoreboardCommand.SelectRosterPlayer2, p.Id)">
                                @if (!string.IsNullOrEmpty(p.PhotoPath))
                                {
                                    <img src="@p.PhotoPath" alt="" />
                                }
                                else if (p.AvatarId is int pickerAvatar)
                                {
                                    <img src="@AvatarGenerator.ToDataUri(pickerAvatar)" alt="" />
                                }
                                else
                                {
                                    <div class="picker-photo-placeholder">?</div>
                                }
                                @if (p.ShortcutNumber is { } shortcut)
                                {
                                    <span class="picker-shortcut">[@shortcut]</span>
                                }
                                <span>@PlayerDisplayNameResolver.Resolve(p, L)</span>
                                @if (taken)
                                {
                                    <small class="picker-taken-note">@L.T("OtherSide")</small>
                                }
                            </button>
                        }
                    </div>
                    <div class="picker-hint">@L.T("PickerNavHint")</div>
                }
            </div>
        </div>
    }

    @if (_showWarmupPicker)
    {
        <div class="player-picker-overlay" @onclick:stopPropagation="true">
            <div class="player-picker-dialog">
                <h3>@L.T("ChooseWarmUpDuration")</h3>
                <div class="warmup-picker-options">
                    <button @onclick="() => StartWarmup(5)">5 @L.T("MinutesUnit") <small>[1]</small></button>
                    <button @onclick="() => StartWarmup(10)">10 @L.T("MinutesUnit") <small>[2]</small></button>
                    <button @onclick="() => StartWarmup(15)">15 @L.T("MinutesUnit") <small>[3]</small></button>
                </div>
                <button class="picker-close" @onclick="CloseWarmupPicker">@L.T("Close") <small>[.]</small></button>
            </div>
        </div>
    }

    @if (_targetEntrySlot != 0)
    {
        <div class="player-picker-overlay" @onclick:stopPropagation="true">
            <div class="player-picker-dialog">
                <h3>@TargetEntryTitle</h3>
                <div class="picker-buffer">@(_targetBuffer.Length > 0 ? _targetBuffer : TargetOf(_targetEntrySlot).ToString())</div>
                <p class="picker-empty">@L.T("TargetEntryHint")</p>
                <button class="picker-close" @onclick="CloseTargetEntry">@L.T("Close") <small>[.]</small></button>
            </div>
        </div>
    }
</div>
}

@code {
    private bool _showControls;

    private static readonly string AppVersion = FormatVersion(typeof(Home).Assembly.GetName().Version);

    private static string FormatVersion(Version? version) => version is null
        ? ""
        : version.Build > 0 ? $"v{version.Major}.{version.Minor}.{version.Build}" : $"v{version.Major}.{version.Minor}";
    private IJSObjectReference? _kiosk;
    private ElementReference board;
    private readonly CancellationTokenSource _shotClockCts = new();

    private Player? _resolvedPlayer1;
    private Player? _resolvedPlayer2;
    private Team? _resolvedTeam1;
    private Team? _resolvedTeam2;
    private List<Player> _rosterPlayers = new();
    private int? _showPlayerPicker;
    private string _pickerBuffer = "";
    private int _pickerIndex;
    private bool _pickerScrollPending;
    private const int PickerPageSize = 8;

    private void MovePicker(int slot, int delta)
    {
        _pickerBuffer = "";
        var last = _rosterPlayers.Count - 1;
        if (last < 0)
        {
            return;
        }

        var step = Math.Sign(delta);
        var target = Math.Clamp(_pickerIndex + delta, 0, last);
        var index = target;
        while (index >= 0 && index <= last && IsTakenByOtherSide(slot, _rosterPlayers[index].Id))
        {
            index += step;
        }

        if (index >= 0 && index <= last)
        {
            _pickerIndex = index;
        }

        _pickerScrollPending = true;
    }

    private int? HighlightedPlayerId
    {
        get
        {
            if (_pickerBuffer.Length > 0)
            {
                return PlayerWithShortcut(_pickerBuffer)?.Id ?? PlayersStartingWith(_pickerBuffer).FirstOrDefault()?.Id;
            }

            return _rosterPlayers.Count > 0 ? _rosterPlayers[Math.Clamp(_pickerIndex, 0, _rosterPlayers.Count - 1)].Id : null;
        }
    }

    private Player? PlayerWithShortcut(string typed) =>
        _rosterPlayers.FirstOrDefault(p => p.ShortcutNumber is { } n && n.ToString() == typed);

    private IEnumerable<Player> PlayersStartingWith(string typed) =>
        _rosterPlayers.Where(p => p.ShortcutNumber is { } n && n.ToString().StartsWith(typed, StringComparison.Ordinal));

    private async Task HandlePickerKeyAsync(int slot, string key)
    {
        LoadRoster();
        switch (key)
        {
            case { Length: 1 } when char.IsDigit(key[0]):
                _pickerBuffer += key;
                var exact = PlayerWithShortcut(_pickerBuffer);
                var longer = PlayersStartingWith(_pickerBuffer).Any(p => p.ShortcutNumber.ToString() != _pickerBuffer);
                if (exact is not null && !longer)
                {
                    await SelectPickerPlayerAsync(slot, exact.Id);
                    return;
                }

                if (exact is null && !longer)
                {
                    _pickerBuffer = "";
                    _ = ShowNoticeAsync(L.T("NoPlayerWithShortcut"));
                }

                break;
            case "Backspace" or "." or "Delete":
                if (_pickerBuffer.Length > 0)
                {
                    _pickerBuffer = _pickerBuffer[..^1];
                }
                else
                {
                    ClosePlayerPicker();
                }

                break;
            case "Escape":
                ClosePlayerPicker();
                break;
            case "ArrowDown" or "+":
                MovePicker(slot, 1);
                break;
            case "ArrowUp" or "-":
                MovePicker(slot, -1);
                break;
            case "PageDown":
                MovePicker(slot, PickerPageSize);
                break;
            case "PageUp":
                MovePicker(slot, -PickerPageSize);
                break;
            case "Enter":
                if (HighlightedPlayerId is int highlighted)
                {
                    await SelectPickerPlayerAsync(slot, highlighted);
                    return;
                }

                break;
        }

        StateHasChanged();
    }

    private Task SelectPickerPlayerAsync(int slot, int playerId) =>
        DispatchAsync(slot == 1 ? ScoreboardCommand.SelectRosterPlayer1 : ScoreboardCommand.SelectRosterPlayer2, playerId);
    private bool _showWarmupPicker;

    private ScoreboardState Current = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Startup.MarkBoardRendered();
        }

        var dialogOpen = AnyDialogOpen;
        if ((firstRender || dialogOpen && !_dialogWasOpen) && !_boardOccupiedElsewhere)
        {
            await board.FocusAsync();
        }

        _dialogWasOpen = dialogOpen;

        if (_pickerScrollPending && _showPlayerPicker is not null)
        {
            _pickerScrollPending = false;
            _kiosk ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/kiosk.js");
            await _kiosk.InvokeVoidAsync("scrollPickerActive");
        }
    }

    private bool _dialogWasOpen;

    private bool AnyDialogOpen => _showMatchEnd || _showPlayerPicker is not null || _showWarmupPicker || _targetEntrySlot != 0;

    private bool _boardOccupiedElsewhere;

    private void OnServerLanguageChanged() =>
        _ = InvokeAsync(() =>
        {
            UpdateDefaultPlayers();
            StateHasChanged();
        });

    private string? _organizationName;

    private void LoadOrganizationName() =>
        _organizationName = SyncOptions.Value.IsConfigured
            ? DbContext.SettingsSet.AsNoTracking().Where(s => s.Id == "OrgName").Select(s => s.Value).FirstOrDefault()
            : null;

    private void LoadRoster() =>
        _rosterPlayers = DbContext.PlayerSet
            .AsNoTracking()
            .OrderBy(p => !p.IsSystem)
            .ThenBy(p => p.SystemSlot)
            .ThenBy(p => p.ShortcutNumber == null)
            .ThenBy(p => p.ShortcutNumber)
            .ThenBy(p => p.Id)
            .ToList();

    private void TakeOverBoard() => Nav.NavigateTo("/?takeover=1", forceLoad: true);

    private void OnBoardSessionReplaced(Guid replacedSessionId)
    {
        if (replacedSessionId != _sessionId)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            _shotClockCts.Cancel();
            _boardOccupiedElsewhere = true;
            StateHasChanged();
        });
    }
    private Guid _sessionId;

    protected override async Task OnInitializedAsync()
    {
        var takeOver = Nav.Uri.Contains("takeover=1", StringComparison.OrdinalIgnoreCase);
        if (takeOver)
        {
            _sessionId = BoardSession.ForceAcquire();
        }
        else if (!BoardSession.TryAcquire(out _sessionId))
        {
            _boardOccupiedElsewhere = true;
            return;
        }

        BoardTracker.SessionId = _sessionId;
        LanguageSync.Changed += OnServerLanguageChanged;
        BoardSession.SessionReplaced += OnBoardSessionReplaced;
        UpdateDefaultPlayers();
        _ = RunShotClockAsync(_shotClockCts.Token);
        var game = await DbContext.ScoreboardStateSet.Where(p => p.Id == 1).FirstOrDefaultAsync();
        if (game is null)
        {
            var saved = new ScoreboardState
            {
                Inning = 0,
                CurrentPoints = 0,
                Player1Score = 0,   
                Player2Score = 0,
                Player1Avg = 0,
                Player2Avg = 0,
                Player1HighRun = 0,
                Player2HighRun = 0,
                ActivePlayer = 1,
                MatchTarget = 20,
                Player1Id = DefaultPlayerId(1),
                Player2Id = DefaultPlayerId(2),
                Player1Name =  L.T("Player1Label"),
                Player2Name = L.T("Player2Label"),
                ShotClockActive  =false,
                ShotClockRemaining = 40,
                ShotClockSeconds = 40
            };
            DbContext.ScoreboardStateSet.Add(saved);
            await DbContext.SaveChangesAsync();
            Current= saved;
        }
        else Current = game;
        ResolvePlayers();
        StateHasChanged();
    }

    private int DefaultPlayerId(int slot) =>
        DbContext.PlayerSet
            .Where(p => p.IsSystem && p.SystemSlot == slot)
            .OrderByDescending(p => p.UpdatedAt != null)
            .Select(p => (int?)p.Id)
            .FirstOrDefault() ?? slot;

    private void ResolvePlayers()
    {
        _resolvedPlayer1 = DbContext.PlayerSet.AsNoTracking().FirstOrDefault(p => p.Id == Current.Player1Id);
        _resolvedPlayer2 = DbContext.PlayerSet.AsNoTracking().FirstOrDefault(p => p.Id == Current.Player2Id);

        if (_resolvedPlayer1 is null)
        {
            Current.Player1Id = DefaultPlayerId(1);
            _resolvedPlayer1 = DbContext.PlayerSet.AsNoTracking().FirstOrDefault(p => p.Id == Current.Player1Id);
        }

        if (_resolvedPlayer2 is null)
        {
            Current.Player2Id = DefaultPlayerId(2);
            _resolvedPlayer2 = DbContext.PlayerSet.AsNoTracking().FirstOrDefault(p => p.Id == Current.Player2Id);
        }

        _resolvedTeam1 = _resolvedPlayer1?.TeamId is int teamId1 ? DbContext.TeamSet.AsNoTracking().FirstOrDefault(t => t.Id == teamId1) : null;
        _resolvedTeam2 = _resolvedPlayer2?.TeamId is int teamId2 ? DbContext.TeamSet.AsNoTracking().FirstOrDefault(t => t.Id == teamId2) : null;
    }

    protected override bool ShouldRender()
    {
        if (!_boardOccupiedElsewhere)
        {
            ResolvePlayers();
            LoadOrganizationName();
            if (_showPlayerPicker is not null)
            {
                LoadRoster();
            }
        }

        return true;
    }

    private string? GetTeamName(int slot) => (slot == 1 ? _resolvedTeam1 : _resolvedTeam2)?.Name;

    private string GetDisplayName(int slot)
    {
        var resolved = slot == 1 ? _resolvedPlayer1 : _resolvedPlayer2;
        if (resolved is not null && resolved.Id is not (1 or 2))
        {
            return PlayerDisplayNameResolver.Resolve(resolved, L);
        }

        var manual = slot == 1 ? Current.Player1Name : Current.Player2Name;
        return string.IsNullOrWhiteSpace(manual) ? L.T(slot == 1 ? "Player1Label" : "Player2Label") : manual;
    }

