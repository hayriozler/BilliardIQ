    private int _targetEntrySlot;
    private string _targetBuffer = "";

    private string TargetEntryTitle => Current.IsHandicap ? $"{L.T("Match")} {L.T(_targetEntrySlot == 1 ? "P1" : "P2")}" : L.T("Match");

    private void OpenTargetEntry()
    {
        _targetEntrySlot = 1;
        _targetBuffer = "";
        StateHasChanged();
    }

    private void CloseTargetEntry()
    {
        _targetEntrySlot = 0;
        _targetBuffer = "";
    }

    private async Task HandleTargetKeyAsync(string key)
    {
        switch (key)
        {
            case { Length: 1 } when char.IsDigit(key[0]):
                if (_targetBuffer.Length < 3)
                {
                    _targetBuffer += key;
                }

                break;
            case "." or "Delete" or "Backspace":
                if (_targetBuffer.Length > 0)
                {
                    _targetBuffer = _targetBuffer[..^1];
                }
                else
                {
                    CloseTargetEntry();
                }

                break;
            case "Escape":
                CloseTargetEntry();
                break;
            case "Enter":
                await CommitTargetEntryAsync();
                return;
        }

        StateHasChanged();
    }

    private async Task CommitTargetEntryAsync()
    {
        if (int.TryParse(_targetBuffer, out var value))
        {
            if (Current.IsHandicap)
            {
                await DispatchAsync(_targetEntrySlot == 1 ? ScoreboardCommand.SetPlayer1Target : ScoreboardCommand.SetPlayer2Target, value);
            }
            else
            {
                await DispatchAsync(ScoreboardCommand.SetMatchTarget, value);
            }
        }

        _targetBuffer = "";
        if (Current.IsHandicap && _targetEntrySlot == 1)
        {
            _targetEntrySlot = 2;
        }
        else
        {
            CloseTargetEntry();
            _matchInputKey++;
        }

        StateHasChanged();
    }

    private bool IsTakenByOtherSide(int slot, int playerId) =>
        playerId == (slot == 1 ? Current.Player2Id : Current.Player1Id);

    private void SelectRosterPlayer(int slot, int playerId)
