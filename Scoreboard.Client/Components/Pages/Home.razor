    {
        var resolved = slot == 1 ? _resolvedPlayer1 : _resolvedPlayer2;
        var nickname = resolved?.Nickname?.Trim();
        var name = resolved?.Name?.Trim();
        if (!string.IsNullOrEmpty(nickname) && !string.IsNullOrEmpty(name) && !string.Equals(nickname, name, StringComparison.OrdinalIgnoreCase))
        {
            return $"{nickname} - {name}";
        }

        return GetDisplayName(slot);
    }

