    private const int PointsToGoThreshold = 3;

    private int? PointsToGo(int slot)
    {
        var remaining = TargetOf(slot) - ScoreOf(slot);
        return remaining is > 0 and <= PointsToGoThreshold ? remaining : null;
    }

    private double ShotClockPercent => Current?.ShotClockSeconds > 0
        ? Math.Clamp(Current.ShotClockRemaining / Current.ShotClockSeconds * 100, 0, 100)
        : 0;

    private int ShotClockDisplaySeconds => (int)Math.Ceiling(Current?.ShotClockRemaining ?? 0);

    private void RecalculateAverages()
    {
        Current.Player1Avg = Current.Inning > 0 ? (double)Current.Player1Score / Current.Inning : 0;
        Current.Player2Avg = Current.Inning > 0 ? (double)Current.Player2Score / Current.Inning : 0;
    }

    private void CommitCurrentPoints()
    {
        var points = Current.CurrentPoints;
        var scoringSlot = Current.ActivePlayer;

        if (Current.ActivePlayer == 1)
        {
            Current.Player1Score += points;
            Current.Player1HighRun = Math.Max(Current.Player1HighRun, points);
            Current.Inning++;
            Current.ActivePlayer = 2;
        }
        else
        {
            Current.Player2Score += points;
            Current.Player2HighRun = Math.Max(Current.Player2HighRun, points);
            Current.ActivePlayer = 1;
        }

        Current.CurrentPoints = 0;
        RecalculateAverages();

        var historyPlayerId = scoringSlot == 1 ? Current.Player1Id : Current.Player2Id;
        var historyInning = DbContext.MatchHistorySet
            .Count(h => h.MatchResultId == null && h.Timestamp >= _gameStartedAt && h.PlayerId == historyPlayerId) + 1;
        DbContext.MatchHistorySet.Add(new MatchHistory
        {
            Timestamp = DateTime.Now,
            PlayerId = historyPlayerId,
            PlayerSlot = scoringSlot,
            Inning = historyInning,
            Score = points,
            TotalScore = scoringSlot == 1 ? Current.Player1Score : Current.Player2Score
        });

        if (!_gameEnded && TargetReached)
        {
            _showMatchEnd = true;
            Current.ShotClockActive = false;
        }
    }

    private bool _gameEnded;
    private DateTime _gameStartedAt = DateTime.Now;

    private int EndGame(bool celebrate = true)
    {
        if (_gameEnded)
        {
            return 0;
        }

        var winner = DetermineWinner();
        var firstTurnAt = DbContext.MatchHistorySet
            .Where(h => h.MatchResultId == null && h.Timestamp >= _gameStartedAt)
            .OrderBy(h => h.Timestamp)
            .Select(h => (DateTime?)h.Timestamp)
            .FirstOrDefault();
        var matchResult = new MatchResult
        {
            PlayedAt = DateTime.Now,
            Player1Id = Current.Player1Id,
            Player1Name = GetDisplayName(1),
            Player1Score = Current.Player1Score,
            Player1Avg = Current.Player1Avg,
            Player1HighRun = Current.Player1HighRun,
            Player2Id = Current.Player2Id,
            Player2Name = GetDisplayName(2),
            Player2Score = Current.Player2Score,
            Player2Avg = Current.Player2Avg,
            Player2HighRun = Current.Player2HighRun,
            Inning = Current.Inning,
            MatchTarget = Current.MatchTarget,
            IsHandicap = Current.IsHandicap,
            Player1Target = Current.IsHandicap ? Current.Player1Target : 0,
            Player2Target = Current.IsHandicap ? Current.Player2Target : 0,
            Winner = winner,
            StartedAt = firstTurnAt ?? _gameStartedAt,
            EndedAt = DateTime.Now
        };
        using var transaction = DbContext.Database.BeginTransaction();
        DbContext.MatchResultSet.Add(matchResult);
        DbContext.SaveChanges();

        var resultId = matchResult.Id;
        DbContext.MatchHistorySet
            .Where(h => h.MatchResultId == null && h.Timestamp >= _gameStartedAt)
            .ExecuteUpdate(s => s.SetProperty(h => h.MatchResultId, resultId));
        transaction.Commit();

        Current.ShotClockActive = false;
        _showMatchEnd = false;
        _gameEnded = true;
        if (celebrate && winner != 0)
        {
            _ = SetFireworksAsync(winner);
        }

        return winner;
    }

    private bool _finishingGame;

    private async Task NewGameAsync()
    {
        if (_finishingGame)
        {
            await SetFireworksAsync(0);
            return;
        }

        if (!_gameEnded && Current.Player1Score > 0 && Current.Player2Score > 0)
        {
            _finishingGame = true;
            try
            {
                var winner = EndGame(celebrate: false);
                if (winner != 0)
                {
                    StateHasChanged();
                    await SetFireworksAsync(winner);
                }
            }
            finally
            {
                _finishingGame = false;
            }
        }

        NewGame();
    }

    private void NewGame()
    {
        _gameEnded = false;
        _showMatchEnd = false;
        _ = SetFireworksAsync(0);
        _gameStartedAt = DateTime.Now;
        Current.Player1Score = 0;
        Current.Player2Score = 0;
        Current.Player1Avg = 0;
        Current.Player2Avg = 0;
        Current.Player1HighRun = 0;
        Current.Player2HighRun = 0;
        Current.Inning = 0;
        Current.CurrentPoints = 0;
        Current.ActivePlayer = 1;
        Current.Player1Id = DefaultPlayerId(1);
        Current.Player2Id = DefaultPlayerId(2);
        Current.Player1Name = "";
        Current.Player2Name = "";
        Current.IsHandicap = false;
        Current.Player1Target = 0;
        Current.Player2Target = 0;
        Current.ShotClockActive = false;
        Current.ShotClockRemaining = Current.ShotClockSeconds;
        ResolvePlayers();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        SystemPower.NotifyKeyDown(e.Key);

        if (SystemPower.IsShuttingDown)
        {
            return;
        }

        if (e.Key is "NumLock" or "Insert" or "Delete" && SystemPower.IsHeld("NumLock") && (SystemPower.IsHeld("Insert") || SystemPower.IsHeld("Delete")))
        {
            return;
        }

        if (_gameEnded)
        {
            ScoreboardCommand? afterEnd = e.Key switch
            {
                "c" or "C" or "9" or "PageUp" => ScoreboardCommand.ToggleControls,
                "n" or "N" or "8" or "ArrowUp" => ScoreboardCommand.NewGame,
                _ => null
            };

            if (afterEnd is not null)
            {
                await ApplyCommandsAsync([new ScoreboardCommandMessage(afterEnd.Value)]);
            }

            return;
        }

        if (_showMatchEnd)
        {
            switch (e.Key)
            {
                case "5" or "Clear":
                    await DispatchAsync(ScoreboardCommand.ExtendMatch, 5);
                    break;
                case "0" or "Insert":
                    await DispatchAsync(ScoreboardCommand.ExtendMatch, 10);
                    break;
                case "*":
                    await DispatchAsync(ScoreboardCommand.NewGame);
                    break;
                case "Delete" or ".":
                    _showMatchEnd = false;
                    StateHasChanged();
                    break;
            }

            return;
        }

        if (_showWarmupPicker)
        {
            switch (e.Key)
            {
                case "1" or "End":
                    StartWarmup(5);
                    break;
                case "2" or "ArrowDown":
                    StartWarmup(10);
                    break;
                case "3" or "PageDown":
                    StartWarmup(15);
                    break;
                case "." or "Delete" or "Backspace" or "Escape":
                    CloseWarmupPicker();
                    break;
            }

            return;
        }

        if (_targetEntrySlot != 0)
        {
            await HandleTargetKeyAsync(e.Key);
            return;
        }

        if (_showPlayerPicker is { } pickerSlot)
        {
            await HandlePickerKeyAsync(pickerSlot, e.Key);
            return;
        }

        if (e.Key is "Backspace")
        {
            if (_showWarmupPicker)
            {
                CloseWarmupPicker();
            }
            else if (_showPlayerPicker is not null)
            {
                ClosePlayerPicker();
            }
            return;
        }

        if (e.Key is "p" or "P" or "0" or "Insert")
        {
            OpenPlayerPicker(Current.ActivePlayer);
            return;
        }

        if (e.Key is "w" or "W" or "5" or "Clear")
        {
            OpenWarmupPicker();
            return;
        }

        if (e.Key is "/")
        {
            OpenTargetEntry();
            return;
        }

        ScoreboardCommand? command = e.Key switch
        {
            "c" or "C" or "9" or "PageUp" => ScoreboardCommand.ToggleControls,
            "t" or "T" or "3" or "PageDown" => ScoreboardCommand.ToggleShotClock,
            "r" or "R" or "6" or "ArrowRight" => ScoreboardCommand.ResetShotClock,
            "1" or "End" => ScoreboardCommand.SelectPlayer1,
            "2" or "ArrowDown" => ScoreboardCommand.SelectPlayer2,
            "*" => ScoreboardCommand.ToggleHandicap,
            "+" or "=" => ScoreboardCommand.IncrementPoints,
            "-" or "_" => ScoreboardCommand.DecrementPoints,
            "Enter" => ScoreboardCommand.CommitPoints,
            "y" or "Y" or "4" or "ArrowLeft" => ScoreboardCommand.SwapPlayers,
            "n" or "N" or "8" or "ArrowUp" => ScoreboardCommand.NewGame,
            _ => null
        };

        if (command is not null)
        {
            await ApplyCommandsAsync([new ScoreboardCommandMessage(command.Value)]);
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e) => SystemPower.NotifyKeyUp(e.Key);

    private void ApplyCommand(ScoreboardCommand command, JsonElement? payload = null)
    {
        switch (command)
        {
            case ScoreboardCommand.ToggleControls:
                _showControls = !_showControls;
                StateHasChanged();
                break;
            case ScoreboardCommand.ToggleShotClock:
                if (Current.ShotClockActive) StopShotClock(); else StartShotClock();
                break;
            case ScoreboardCommand.ResetShotClock:
                ResetShotClock();
                break;
            case ScoreboardCommand.SelectPlayer1:
                ChangeActivePlayer(1);
                break;
            case ScoreboardCommand.SelectPlayer2:
                ChangeActivePlayer(2);
                break;
            case ScoreboardCommand.IncrementPoints:
                Current.CurrentPoints++;
                break;
            case ScoreboardCommand.DecrementPoints:
                Current.CurrentPoints--;
                break;
            case ScoreboardCommand.CommitPoints:
                CommitCurrentPoints();
                break;

            case ScoreboardCommand.RenamePlayer1:
                SetPlayerName(1, GetStringPayload(payload));
                break;
            case ScoreboardCommand.RenamePlayer2:
                SetPlayerName(2, GetStringPayload(payload));
                break;
            case ScoreboardCommand.EndGame:
                EndGame();
                break;
            case ScoreboardCommand.ExtendMatch:
                if (GetIntPayload(payload) is int extraPoints and > 0)
                {
                    ExtendMatch(extraPoints);
                }

                break;
            case ScoreboardCommand.SetMatchTarget:
                if (GetIntPayload(payload) is int matchTarget)
                {
                    SetMatchTarget(matchTarget);
                }
                break;
            case ScoreboardCommand.SwapPlayers:
                SwapPlayers();
                break;
            case ScoreboardCommand.ToggleHandicap:
                ToggleHandicap();
                break;
            case ScoreboardCommand.SetPlayer1Target:
                if (GetIntPayload(payload) is int player1Target)
                {
                    SetPlayerTarget(1, player1Target);
                }
                break;
            case ScoreboardCommand.SetPlayer2Target:
                if (GetIntPayload(payload) is int player2Target)
                {
                    SetPlayerTarget(2, player2Target);
                }
                break;
            case ScoreboardCommand.SelectRosterPlayer1:
                if (GetIntPayload(payload) is int rosterPlayer1Id)
                {
                    SelectRosterPlayer(1, rosterPlayer1Id);
                }
                break;
            case ScoreboardCommand.SelectRosterPlayer2:
                if (GetIntPayload(payload) is int rosterPlayer2Id)
                {
                    SelectRosterPlayer(2, rosterPlayer2Id);
                }
                break;
            case ScoreboardCommand.ClearRosterPlayer1:
                ClearRosterPlayer(1);
                break;
            case ScoreboardCommand.ClearRosterPlayer2:
                ClearRosterPlayer(2);
                break;
        }
    }

    private static string? GetStringPayload(JsonElement? payload) =>
        payload?.ValueKind == JsonValueKind.String ? payload.Value.GetString() : null;

    private static int? GetIntPayload(JsonElement? payload) =>
        payload?.ValueKind == JsonValueKind.Number && payload.Value.TryGetInt32(out var value) ? value : null;

    private async Task ApplyCommandsAsync(IReadOnlyList<ScoreboardCommandMessage> messages)
    {
        if (messages.Count == 0 || SystemPower.IsShuttingDown)
        {
            return;
        }

        foreach (var message in messages)
        {
            if (message.Command == ScoreboardCommand.NewGame)
            {
                await NewGameAsync();
            }
            else
            {
                ApplyCommand(message.Command, message.Payload);
            }
        }

        await PersistAsync();
    }

    private Task DispatchAsync(ScoreboardCommand command, object? payload = null) =>
        ApplyCommandsAsync([new ScoreboardCommandMessage(command, payload is null ? null : JsonSerializer.SerializeToElement(payload))]);

    private async Task SetPlayerTargetFromInputAsync(int slot, string? value)
    {
        if (int.TryParse(value, out var target))
        {
            await DispatchAsync(slot == 1 ? ScoreboardCommand.SetPlayer1Target : ScoreboardCommand.SetPlayer2Target, target);
        }

        _matchInputKey++;
    }

    private async Task SetMatchTargetFromInputAsync(string? value)
    {
        if (int.TryParse(value, out var target))
        {
            await DispatchAsync(ScoreboardCommand.SetMatchTarget, target);
        }

        _matchInputKey++;
    }

    private void ChangeActivePlayer(int player) => Current.ActivePlayer = player;

    private void SwapPlayers()
    {
        if (_gameEnded)
        {
            return;
        }

        (Current.Player1Id, Current.Player2Id) = (Current.Player2Id, Current.Player1Id);
        (Current.Player1Name, Current.Player2Name) = (Current.Player2Name, Current.Player1Name);
        (Current.Player1Score, Current.Player2Score) = (Current.Player2Score, Current.Player1Score);
        (Current.Player1HighRun, Current.Player2HighRun) = (Current.Player2HighRun, Current.Player1HighRun);
        (Current.Player1Target, Current.Player2Target) = (Current.Player2Target, Current.Player1Target);
        Current.ActivePlayer = Current.ActivePlayer == 1 ? 2 : 1;
        RecalculateAverages();

        foreach (var row in DbContext.MatchHistorySet.Where(h => h.MatchResultId == null && h.Timestamp >= _gameStartedAt))
        {
            row.PlayerSlot = row.PlayerSlot == 1 ? 2 : 1;
        }

        ResolvePlayers();
    }

    private async Task SetFireworksAsync(int winner)
    {
        try
        {
            _kiosk ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/kiosk.js");
            if (winner == 0)
            {
                await _kiosk.InvokeVoidAsync("stopFireworks");
            }
            else
            {
                await _kiosk.InvokeVoidAsync("startFireworks", winner);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    private async Task RequestFullscreenAsync()
    {
        _kiosk ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/kiosk.js");
        await _kiosk.InvokeVoidAsync("requestFullscreen");
        await board.FocusAsync();
    }

    private async Task RunShotClockAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
            var ticks = 0;
            var last = System.Diagnostics.Stopwatch.GetTimestamp();
            while (await timer.WaitForNextTickAsync(token))
            {
                var elapsed = System.Diagnostics.Stopwatch.GetElapsedTime(last).TotalSeconds;
                last = System.Diagnostics.Stopwatch.GetTimestamp();
                try
                {
                    await InvokeAsync(() => ShotClockTick(elapsed, ++ticks % 30 == 0));
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    Logger.LogError(ex, "Shot clock tick failed.");
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ShotClockTick(double elapsedSeconds, bool refresh)
    {
        if (SystemPower.IsShuttingDown)
        {
            return;
        }

        if (!Current.ShotClockActive)
        {
            if (refresh) StateHasChanged();
            return;
        }

        Current.ShotClockRemaining = Math.Max(0, Current.ShotClockRemaining - elapsedSeconds);
        if (Current.ShotClockRemaining <= 0)
        {
            Current.ShotClockActive = false;
            Current.ShotClockRemaining = Current.ShotClockSeconds;
            DbContext.SaveChanges();
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        LanguageSync.Changed -= OnServerLanguageChanged;
        BoardSession.SessionReplaced -= OnBoardSessionReplaced;
        BoardSession.Release(_sessionId);
        if (_boardOccupiedElsewhere)
        {
            return;
        }

        if (_shotClockCts is not null)
        {
            _shotClockCts.Cancel();
            _shotClockCts.Dispose();
        }
        try
        {
            if (_kiosk is not null)
            {
                await _kiosk.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
