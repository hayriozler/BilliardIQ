    private string? GetTeamAvatarDataUri(int slot) =>
        (slot == 1 ? _resolvedTeam1 : _resolvedTeam2)?.AvatarId is int teamAvatarId ? AvatarGenerator.ToDataUri(teamAvatarId) : null;

    private string? GetAvatarDataUri(int slot) =>
        (slot == 1 ? _resolvedPlayer1 : _resolvedPlayer2)?.AvatarId is int avatarId ? AvatarGenerator.ToDataUri(avatarId) : null;

    private string GetAvatarInitials(int slot)
    {
        var name = GetDisplayName(slot);
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private string GetAvatarColor(int slot)
    {
        var hash = 0;
        foreach (var c in GetDisplayName(slot)) hash = hash * 31 + c;
        return AvatarGenerator.GetColor(hash);
    }

