    private const int MinMatchTarget = 10;
    private const int MaxMatchTarget = 100;
    private int _matchInputKey;

    private void SetMatchTarget(int target) => Current.MatchTarget = Math.Clamp(target, MinMatchTarget, MaxMatchTarget);

    private const int MinHandicapTarget = 5;
    private const int MaxHandicapTarget = 100;

    private void ToggleHandicap()
    {
        Current.IsHandicap = !Current.IsHandicap;
        if (Current.IsHandicap && Current.Player1Target == 0 && Current.Player2Target == 0)
        {
            Current.Player1Target = Current.Player2Target = Math.Clamp(Current.MatchTarget, MinHandicapTarget, MaxHandicapTarget);
        }

        _matchInputKey++;
    }

    private void SetPlayerTarget(int slot, int target)
    {
        var clamped = Math.Clamp(target, MinHandicapTarget, MaxHandicapTarget);
        if (slot == 1)
        {
            Current.Player1Target = clamped;
        }
        else
        {
            Current.Player2Target = clamped;
        }
    }

    private int TargetOf(int slot) =>
        Current.IsHandicap ? (slot == 1 ? Current.Player1Target : Current.Player2Target) : Current.MatchTarget;

    private int ScoreOf(int slot) => slot == 1 ? Current.Player1Score : Current.Player2Score;

    private bool ReachedTarget(int slot) => TargetOf(slot) > 0 && ScoreOf(slot) >= TargetOf(slot);

    private bool TargetReached => Current.IsHandicap
        ? ReachedTarget(1) || ReachedTarget(2)
        : Current.MatchTarget > 0 && Math.Max(Current.Player1Score, Current.Player2Score) >= Current.MatchTarget;

    private double TargetProgress(int slot) => TargetOf(slot) > 0 ? (double)ScoreOf(slot) / TargetOf(slot) : 0;

    private bool _showMatchEnd;

    private int MatchLeaderSlot => Current.IsHandicap
        ? (ReachedTarget(1) && !ReachedTarget(2) ? 1 : ReachedTarget(2) && !ReachedTarget(1) ? 2 : TargetProgress(1) >= TargetProgress(2) ? 1 : 2)
        : Current.Player1Score >= Current.Player2Score ? 1 : 2;

    private int ExtendedTargetOf(int slot, int extraPoints) =>
        Math.Max(TargetOf(slot), ScoreOf(slot)) + extraPoints;

    private int ExtendedTarget(int extraPoints) =>
        Math.Max(Current.MatchTarget, Math.Max(Current.Player1Score, Current.Player2Score)) + extraPoints;

    private string ExtendedLabel(int extraPoints) => Current.IsHandicap
        ? $"{ExtendedTargetOf(1, extraPoints)} │ {ExtendedTargetOf(2, extraPoints)}"
        : ExtendedTarget(extraPoints).ToString();

    private void ExtendMatch(int extraPoints)
    {
        if (Current.IsHandicap)
        {
            var player1Target = ExtendedTargetOf(1, extraPoints);
            Current.Player2Target = ExtendedTargetOf(2, extraPoints);
            Current.Player1Target = player1Target;
        }
        else
        {
            Current.MatchTarget = ExtendedTarget(extraPoints);
        }

        _showMatchEnd = false;
    }

    private int DetermineWinner()
    {
        if (Current.IsHandicap)
        {
            if (ReachedTarget(1) != ReachedTarget(2))
            {
                return ReachedTarget(1) ? 1 : 2;
            }

            return TargetProgress(1) > TargetProgress(2) ? 1 : TargetProgress(2) > TargetProgress(1) ? 2 : 0;
        }

        return Current.Player1Score > Current.Player2Score ? 1
            : Current.Player2Score > Current.Player1Score ? 2
            : 0;
    }

    private void StopShotClock() => Current.ShotClockActive = false;

    private void StartShotClock() => Current.ShotClockActive = true;

    private void ResetShotClock()
