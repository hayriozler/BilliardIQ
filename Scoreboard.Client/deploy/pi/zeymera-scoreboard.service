# systemd unit for the Zeymera Scoreboard kiosk app.
#
# One-time install (as a sudoer on the Pi):
#   sudo cp deploy/pi/zeymera-scoreboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zeymera-scoreboard.service
#
# After every redeploy (publish-and-deploy.ps1 does this automatically):
#   sudo systemctl restart zeymera-scoreboard.service
#
# WorkingDirectory matters at runtime, not just for finding the .dll: Program.cs creates
# wwwroot/Db and wwwroot/Players relative to Directory.GetCurrentDirectory(), not relative
# to the .dll's own location.

[Unit]
Description=Zeymera Scoreboard
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/zeymera-scoreboard
Environment=ASPNETCORE_URLS=http://0.0.0.0:5288
Environment=DOTNET_ROOT=/home/admin/.dotnet
ExecStart=/home/admin/.dotnet/dotnet /home/admin/zeymera-scoreboard/Scoreboard.Client.dll
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
